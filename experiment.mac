/* =====================================================================
   experiment.mac

   Computational experiments for:
   "Emergent Fractional Dimensionality and Spinor-Like Holonomy
    in Multi-Sheeted Pentagon Tilings"

   Where analysis.mac verifies the *symbolic identities* underlying the
   construction (phi-arithmetic, cyclotomic structure, Alexander-Orbach
   relation, etc.), this file performs *constructive numerical
   experiments* on small instances of the multi-sheeted pentagon graph.

   The experiments are designed to:
     (1) Build a concrete multi-sheeted pentagon adjacency graph in
         exact Q(sqrt(5)) arithmetic.
     (2) Compute the graph Laplacian and its eigenspectrum.
     (3) Estimate the connectivity dimension d_eff from BFS volume
         growth N(r) ~ r^d_eff.
     (4) Simulate random walks to estimate the walk dimension d_w
         from <Delta x^2(t)> ~ t^(2/d_w) and the spectral dimension
         d_spec from P_0(t) ~ t^(-d_spec/2).
     (5) Cross-check d_spec via the Alexander-Orbach relation
         d_spec = 2 d_eff / d_w.
     (6) Demonstrate holonomy accumulation around a vortex defect
         for fiber groups G = Z_2 (spinor) and G = Z_5 (anyonic).
     (7) Run a small Pentagonal-Life-like cellular automaton on the
         constructed graph and observe glider/cluster behavior.

   Sections:
      1. Setup and Q(sqrt(5)) machinery
      2. Pentagon geometry in Q(sqrt(5))
      3. Multi-sheeted adjacency graph construction
      4. Graph Laplacian and spectral analysis
      5. BFS volume growth: connectivity dimension d_eff
      6. Random-walk simulation: d_w and d_spec
      7. Alexander-Orbach cross-check
      8. Holonomy experiments (Z_2 and Z_5 fibers)
      9. Cellular automaton dynamics
      10. Extended ruleset survey (B/S families)
      11. Alternative tau-rules: holonomy and structure comparison
      12. Extended holonomy: Z_3, Z_4, Z_6, Z_10 fiber groups
      13. Structural pattern analysis: clustering, girth, sheet flow
      14. Per-sheet sub-graph analysis
      15. Glider/oscillator hunt under multiple seeds
      16. Long-loop holonomy enumeration (length 6-8)
      17. Cut-and-project acceptance window experiment
      18. KPM-based spectral density approximation
      19. Per-sheet random walk diagnostics
      20. Cross-tau dimensional comparison
      21. Resistance distance and commute time
      22. Summary report
   ===================================================================== */

if not(?boundp('display2d)) then display2d : false$

print("============================================================")$
print("experiment.mac : Multi-Sheeted N-Gon Tiling Experiments")$
print("============================================================")$

/* Make pseudo-random results reproducible. */
/* set_random_state signature varies between Maxima builds; guard it. */
if ?fboundp('make_random_state) then
     set_random_state(make_random_state(20250101))
else
     print("(note: make_random_state unavailable; using default RNG seed)")$
/* =====================================================================
     SECTION 0.  PARAMETERIZATION
     ---------------------------------------------------------------------
     N_GON controls the polygon type for all geometry, holonomy, and CA
     experiments.  Set it here; everything else follows automatically.
       n = 3  : equilateral triangle
       n = 4  : square
       n = 5  : regular pentagon  (original paper)
       n = 6  : regular hexagon
       n = 7  : regular heptagon
       n = 8  : regular octagon
       n = 12 : regular dodecagon
     Note: for n in {3, 4, 6} the tiling closes flat (deficit = 0) so
     the sheet-transition mechanism is trivial unless a non-zero tau
     rule is forced.  The most interesting fractional-dimension regime
     arises for n = 5 (and other n where the angular deficit is an
     irrational multiple of 2*pi).
     ===================================================================== */
N_GON : 5 $   /* <-- change this to study other n-gons */
/* Sweep override: sweep_ngon.mac may set EXPERIMENT_N_GON_OVERRIDE
   before batching this file.  Honor it if present. */
if ?boundp('EXPERIMENT_N_GON_OVERRIDE) then
    N_GON : EXPERIMENT_N_GON_OVERRIDE $
if not integerp(N_GON) or N_GON < 3
    then error("N_GON must be an integer >= 3; got", N_GON)$
n_int : N_GON $
print("------------------------------------------------------------")$
print("PARAMETERIZATION:  N_GON =", N_GON)$
print("------------------------------------------------------------")$
/* Derived angular constants. */
theta_int_n : (n_int - 2)*%pi / n_int $   /* interior angle */
theta_ext_n : 2*%pi / n_int $             /* exterior / central angle */
k_flat_n    : floor(2*%pi / theta_int_n) $  /* n-gons around a flat vertex */
deficit_n   : ratsimp(2*%pi - k_flat_n * theta_int_n) $
k_loop_close_n : 2*n_int / gcd(2*n_int, n_int - 2) $
print("  Interior angle =", float(theta_int_n * 180 / %pi), "deg")$
print("  Flat-vertex count k_flat =", k_flat_n)$
print("  Angular deficit =", float(deficit_n * 180 / %pi), "deg")$
print("  Loop-closure index k_loop =", k_loop_close_n)$
/* Natural fiber group order for this n-gon. */
FIBER_ORDER_N : k_loop_close_n $
print("  Natural fiber group order =", FIBER_ORDER_N)$
/* Holonomy fiber groups to survey (always include 2, n_int, and the
    natural fiber order; deduplicate and sort). */
FIBER_GROUPS_DEFAULT : sort(listify(setify(
     append([2, n_int, FIBER_ORDER_N],
            if n_int <= 12 then [3, 4, 5, 6, 10] else [])))) $
print("  Fiber groups for holonomy survey:", FIBER_GROUPS_DEFAULT)$

/* ---------------------------------------------------------------------
    Shared utility: least-squares slope/intercept of (xs, ys).
    Defined early so every section can use it.
    --------------------------------------------------------------------- */
log_log_fit_basic(xs, ys) := block(
     [n : length(xs), sx, sy, sxx, sxy, slope, intercept],
     sx : apply("+", xs),
     sy : apply("+", ys),
     sxx : apply("+", xs*xs),
     sxy : apply("+", xs*ys),
     slope : (n * sxy - sx*sy) / (n * sxx - sx^2),
     intercept : (sy - slope * sx) / n,
     [float(slope), float(intercept)]) $
/* =====================================================================
    CONFIGURATION PARAMETERS
    ---------------------------------------------------------------------
    These parameters control the computational cost of the experiment.
    Adjust them to trade off runtime vs. statistical/spectral quality.
    Presets (set EXPERIMENT_PRESET below to one of these strings):
       "tiny"    -- smoke test; runs in a few seconds. Cluster ~ 10-30
                    cells, very short walks. Useful for syntax checking.
       "small"   -- default; runs in well under a minute on a laptop.
                    Cluster ~ 30-80 cells, ~200 walks of length 20.
                    Indicative dimension fits; matches the original
                    behaviour of this script.
       "medium"  -- runs in a few minutes. Cluster ~ 200-500 cells,
                    ~1000 walks of length 60. Better dimension fits,
                    LAPACK eigenvalues still tractable.
       "large"   -- runs in tens of minutes to an hour. Cluster ~
                    1000-3000 cells, ~5000 walks of length 200.
                    Eigenvalue step is the bottleneck (O(N^3)).
       "huge"    -- research-grade run; may take hours and a lot of
                    memory. Eigenvalues may be skipped if SKIP_EIG
                    is true (see below).
      "xhuge"   -- extra-large run: BFS depth 6, longer walks,
                   more KPM moments. Intended for the upgraded
                   pipeline (signed/cap tau-rule + KPM spectral
                   analysis). Hours of runtime; eigenvalues skipped.
       "custom"  -- ignore the preset and use whatever individual
                    parameter values are set below.
    Individual parameters (override after preset block if desired):
       BFS_DEPTH      -- BFS expansion depth for cluster construction.
                         Cluster size grows roughly like 5^BFS_DEPTH.
       M_WALKS        -- number of random walks for d_w / d_spec fits.
       T_STEPS        -- length of each random walk.
       T_CA           -- number of cellular-automaton time steps.
       SKIP_EIG       -- if true, skip the Laplacian eigendecomposition
                         (Section 4). Useful for very large clusters
                         where O(N^3) LAPACK is too slow.
       EIG_MAX_N      -- safety cap: auto-skip eigendecomposition if
                         cluster size exceeds this value, regardless
                         of SKIP_EIG.
      TAU_MODE       -- selects the default vortex rule used in the
                        main BFS expansion (Section 3) and downstream
                        analyses.  Values:
                          "every3"  -- the original didactic rule
                                       tau(i,k) = [(i+k) ≡ 0 mod 3],
                                       always +1.
                          "signed3" -- the signed-3 rule from the
                                       tau-survey: tau in {-1,0,+1}.
                                       Produces the largest clusters
                                       and the most sheets, and gives
                                       d_eff closest to the predicted
                                       midpoint 2.5.
                          "cap"     -- the cut-and-project acceptance
                                       window rule of Section 17:
                                       shift +1 iff exactly one
                                       endpoint lies inside the
                                       pentagonal acceptance window.
                                       This is the rigorous regime of
                                       idea.md §2.4.
    ===================================================================== */
EXPERIMENT_PRESET : "xhuge" $
if ?boundp('EXPERIMENT_PRESET_OVERRIDE) then
    EXPERIMENT_PRESET : EXPERIMENT_PRESET_OVERRIDE $
/* Default vortex rule for the main cluster.  Set to "signed3" or
    "cap" to use the upgraded rules instead of the didactic every3. */
TAU_MODE : "signed3" $
if ?boundp('EXPERIMENT_TAU_OVERRIDE) then
    TAU_MODE : EXPERIMENT_TAU_OVERRIDE $
if EXPERIMENT_PRESET = "tiny" then (
     BFS_DEPTH : 1,
     M_WALKS   : 50,
     T_STEPS   : 10,
     T_CA      : 4,
     SKIP_EIG  : false,
     EIG_MAX_N : 1500,
     KPM_MOMENTS : 64,
     KPM_SAMPLES : 8,
     LONG_LOOP_MAX : 6
) elseif EXPERIMENT_PRESET = "small" then (
     BFS_DEPTH : 2,
     M_WALKS   : 200,
     T_STEPS   : 20,
     T_CA      : 8,
     SKIP_EIG  : false,
     EIG_MAX_N : 1500,
     KPM_MOMENTS : 96,
     KPM_SAMPLES : 12,
     LONG_LOOP_MAX : 6
) elseif EXPERIMENT_PRESET = "medium" then (
     BFS_DEPTH : 3,
     M_WALKS   : 1000,
     T_STEPS   : 60,
     T_CA      : 16,
     SKIP_EIG  : false,
     EIG_MAX_N : 1500,
     KPM_MOMENTS : 128,
     KPM_SAMPLES : 16,
     LONG_LOOP_MAX : 7
) elseif EXPERIMENT_PRESET = "large" then (
     BFS_DEPTH : 4,
     M_WALKS   : 5000,
     T_STEPS   : 200,
     T_CA      : 32,
     SKIP_EIG  : false,
     EIG_MAX_N : 2500,
     KPM_MOMENTS : 192,
     KPM_SAMPLES : 20,
     LONG_LOOP_MAX : 7
) elseif EXPERIMENT_PRESET = "huge" then (
     BFS_DEPTH : 5,
     M_WALKS   : 20000,
     T_STEPS   : 500,
     T_CA      : 64,
     SKIP_EIG  : true,
     EIG_MAX_N : 3000,
     KPM_MOMENTS : 256,
     KPM_SAMPLES : 24,
     LONG_LOOP_MAX : 8
) elseif EXPERIMENT_PRESET = "xhuge" then (
     BFS_DEPTH : 6,
     M_WALKS   : 40000,
     T_STEPS   : 800,
     T_CA      : 96,
     SKIP_EIG  : true,
     EIG_MAX_N : 3000,
     KPM_MOMENTS : 384,
     KPM_SAMPLES : 32,
     LONG_LOOP_MAX : 8
) elseif EXPERIMENT_PRESET = "custom" then (
     /* Edit these directly for hand-tuned runs. */
     BFS_DEPTH : 2,
     M_WALKS   : 200,
     T_STEPS   : 20,
     T_CA      : 8,
     SKIP_EIG  : false,
     EIG_MAX_N : 1500,
     KPM_MOMENTS : 96,
     KPM_SAMPLES : 12,
     LONG_LOOP_MAX : 6
) else
     error("Unknown EXPERIMENT_PRESET: ", EXPERIMENT_PRESET) $
/* Early-time MSD fitting window: we want the genuine sub-diffusive
    regime, not the boundary-saturated plateau.  The cluster diameter
    is ~ 2*BFS_DEPTH, so we cap the fit at half that. */
MSD_FIT_LO : 2 $
MSD_FIT_HI : max(4, min(T_STEPS, BFS_DEPTH)) $
/* P_0 fit window: same idea, even t only. */
P0_FIT_LO  : 2 $
P0_FIT_HI  : max(4, min(T_STEPS, 2*BFS_DEPTH)) $
print("Configuration:")$
print("  preset    =", EXPERIMENT_PRESET)$
print("  TAU_MODE  =", TAU_MODE)$
print("  BFS_DEPTH =", BFS_DEPTH)$
print("  M_WALKS   =", M_WALKS)$
print("  T_STEPS   =", T_STEPS)$
print("  T_CA      =", T_CA)$
print("  SKIP_EIG  =", SKIP_EIG)$
print("  EIG_MAX_N =", EIG_MAX_N)$
print("  MSD fit window t in [", MSD_FIT_LO, ",", MSD_FIT_HI, "]")$
print("  P_0 fit window t in [", P0_FIT_LO,  ",", P0_FIT_HI,  "] (even t)")$
print("  KPM_MOMENTS =", KPM_MOMENTS)$
print("  KPM_SAMPLES =", KPM_SAMPLES)$
print("  LONG_LOOP_MAX =", LONG_LOOP_MAX)$
print("  N_GON =", N_GON)$

/* ---------------------------------------------------------------------
    SECTION 1.  Setup and field arithmetic machinery
   --------------------------------------------------------------------- */

/* Canonicalize an algebraic number for hashable equality. */
qcanon(z) := ratsimp(expand(z)) $

/* Test two algebraic numbers for exact equality in Q(sqrt(5)). */
qeq(a, b) := is(qcanon(a - b) = 0) $

/* Pentagon-specific golden-ratio constants (kept for n=5 compatibility
    and for use in the cut-and-project window of Section 17). */
phi : (1 + sqrt(5))/2 $
psi : (1 - sqrt(5))/2 $
if N_GON = 5 then (
     c72  : (sqrt(5) - 1)/4,
     s72  : sqrt(10 + 2*sqrt(5))/4,
     c144 : -(sqrt(5) + 1)/4,
     s144 : sqrt(10 - 2*sqrt(5))/4,
     if not qeq(phi^2, phi + 1) then error("phi^2 != phi + 1"),
     if not qeq(c72^2 + s72^2, 1) then error("cos^2(72)+sin^2(72) != 1"),
     if not qeq(c144^2 + s144^2, 1) then error("cos^2(144)+sin^2(144) != 1"),
     print("Section 1: Q(sqrt(5)) arithmetic primitives OK.")
) else
     print("Section 1: generic field arithmetic (N_GON =", N_GON, ").")$

/* ---------------------------------------------------------------------
    SECTION 2.  N-gon geometry
   ---------------------------------------------------------------------

    A regular n-gon is described by:
      centroid    : [cx, cy]  in Q(sqrt(5))^2
      chirality   : c in {0, 1}   (orientation class under D_n action)
      sheet       : s in Z  (or Z_n)

    Circumradius for unit edge: R = 1/(2 sin(pi/n)).
    We use R as a free symbolic constant; it never appears in equality
    comparisons -- only differences of centroids do.  For pure adjacency
    tests we work with the *edge midpoint* normalized form.

    Orientation:  rotating a regular n-gon by 2*pi/n maps it to itself,
    so multiples-of-2*pi/n rotations are NOT distinguishing labels and
    must not appear in the cell-identity tuple.  What is distinguishing
    is *chirality* (handedness), because reflecting across an edge flips
    the orientation class.

        - For odd n (n = 3, 5, 7, ...): the n-gon has no edge-midpoint
          symmetry axis, so reflection across an edge does NOT lie in
          the rotation subgroup of D_n.  The dual graph is bipartite:
          every edge connects "up" cells (chirality 0) to "down" cells
          (chirality 1).  Every closed walk on the tiling has even
          length on the chirality bigraph.

        - For even n (n = 4, 6, 8, ...): the n-gon has an edge-midpoint
          axis through every edge, so reflection across an edge is
          realized by a rotation in D_n.  Chirality collapses to a
          single class.  We carry chirality = 0 trivially.

    The chirality bit also resolves the previous code's silent
    absorption of the orientation flip into the sheet index, which
    was conflating two distinct degrees of freedom (geometric
    handedness and physical sheet monodromy).
   --------------------------------------------------------------------- */

/* Parity-dependent chirality use:
    For odd n the bigraph is non-trivial; for even n chirality is
    a constant 0 and we never enumerate it. */
CHIRAL_ACTIVE : oddp(n_int) $

/* Flip chirality across an edge: for odd n the reflection takes
    "up" to "down"; for even n it stays the same. */
flip_chir(c) := if CHIRAL_ACTIVE then mod(c + 1, 2) else 0 $

/* Rotation table: rot_cs[k+1] = [cos(k * 2*pi/n), sin(k * 2*pi/n)]
    for k = 0 .. n_int-1.  Stored as exact symbolic expressions so that
    equality comparisons on centroids remain exact. */
rot_cs : makelist(
     [qcanon(cos(k * 2*%pi / n_int)),
      qcanon(sin(k * 2*%pi / n_int))],
     k, 0, n_int - 1) $

/* Apply rotation by k*(2*pi/n) to a 2-vector. */
rot_ngon(v, k) := block(
     [cs : rot_cs[mod(k, n_int) + 1], c, s],
    c : cs[1], s : cs[2],
    [c*v[1] - s*v[2], s*v[1] + c*v[2]]) $

/* The n unit vectors from n-gon center to its vertices, with vertex
    0 pointing in the +x direction.  These are the "spoke" directions. */
spoke(k) := rot_ngon([1, 0], k) $

/* Edge midpoints (relative to center) for orientation = 0:
    midpoint of edge k is halfway between vertex k and vertex k+1. */
edge_mid_rel(k) := block(
    [v1 : spoke(k), v2 : spoke(k+1)],
    [(v1[1] + v2[1])/2, (v1[2] + v2[2])/2]) $


/* Canonical edge midpoint for a cell at (cx, cy) with chirality chir.
    Up-cells (chir = 0) use the base orientation; down-cells (chir = 1)
    are reflected across the x-axis, which is one realization of the
    chirality-flipping reflection.  For even n, chir is always 0 and
    we just use the base orientation. */
edge_midpoint(cx, cy, chir, k) := block(
     [m : edge_mid_rel(k), mx, my],
     mx : m[1],
     my : if chir = 1 then -m[2] else m[2],
     [qcanon(cx + mx), qcanon(cy + my)]) $

/* (kept for backward-compatible call sites in tau_rule_cap stub) */
edge_normal_rel(chir, k) := block(
     [m : edge_mid_rel(k)],
     if chir = 1 then [m[1], -m[2]] else m) $

/* When two n-gons share an edge, the neighbor's center is the
    reflection of the current center across that edge midpoint:
       neighbor center = 2 * edge_mid - my_center
    Chirality flips across each edge for odd n (bipartite dual graph),
    and is constant for even n.  The genuine angular deficit, when
    nonzero, is absorbed into the sheet index via tau_rule.             */

print("Section 2: N-gon geometry primitives OK (N_GON =", N_GON, ").")$
print("  CHIRAL_ACTIVE =", CHIRAL_ACTIVE,
       if CHIRAL_ACTIVE then " (odd n: bipartite orientation bigraph)"
                        else " (even n: single orientation class)")$

/* ---------------------------------------------------------------------
   SECTION 3.  Multi-sheeted adjacency graph construction
   ---------------------------------------------------------------------

    We construct a multi-sheeted n-gon adjacency graph by BFS from an
    origin n-gon.  Each n-gon has n edges; the tau rule determines which
    edges carry a sheet transition.

    Nodes are identified by integer IDs 1..N.  We store:
      cell_center[i]  -- exact [cx, cy] in Q(sqrt(5))
       cell_chir[i]    -- chirality bit in {0, 1}; constantly 0 for even n
      cell_sheet[i]   -- integer (Z) or residue (Z_n)
   and the adjacency list nbrs[i] -- list of neighbor IDs.
    Note: the previous version of this code stored a 5-valued
    `cell_orient` field representing multiples of 2*pi/n.  That field
    was geometrically meaningless because rotating a regular n-gon by
    2*pi/n maps it to itself, so identity should not depend on it.
    Worse, on a same-orientation tiling the reflection across an edge
    flips chirality for odd n, but the old code kept orientation fixed,
    silently absorbing the flip into the sheet index.  The chirality
    bit below now tracks that geometric degree of freedom explicitly.

    The cluster is generated by BFS from the origin n-gon, materializing
    neighbors lazily.
   --------------------------------------------------------------------- */

/* Storage: associative arrays keyed by integer ID. */
cell_center : [] $
cell_chir   : [] $
cell_sheet  : [] $
cell_count  : 0 $
nbrs        : [] $
/* Hash index: maps a float fingerprint -> list of candidate cell IDs.
   This turns find_cell from O(N) into O(1) amortized.  We use a
   Maxima hash array; collisions are resolved by exact qeq check. */
cell_hash   : 0 $
cell_hash   : ?make\-hash\-table() $
/* Float fingerprint of a (center, chirality, sheet) tuple.  Rounded to
   a fixed grid so exact-equal centers always hash the same. */
cell_fingerprint(c, chir, s) := block(
    [fx : float(ratsimp(expand(c[1]))),
     fy : float(ratsimp(expand(c[2])))],
    [round(fx * 1048576), round(fy * 1048576), mod(chir, 2), s]) $


/* Add a cell and return its ID.  The middle argument is chirality. */
add_cell(c, chir, s) := block(
    [id, fp],
    cell_count : cell_count + 1,
    id : cell_count,
    cell_center : endcons([qcanon(c[1]), qcanon(c[2])], cell_center),
    cell_chir   : endcons(mod(chir, 2), cell_chir),
    cell_sheet  : endcons(s, cell_sheet),
    nbrs        : endcons([], nbrs),
    fp : cell_fingerprint(c, chir, s),
    block([prev : ?gethash(fp, cell_hash, [])],
          ?puthash(fp, cell_hash, endcons(id, prev))),
    id) $

/* Look up a cell with given (center, chirality, sheet); returns 0 if absent.
   Uses exact Q(sqrt(5)) comparisons. */
find_cell(c, chir, s) := block(
    [fp : cell_fingerprint(c, chir, s),
     cx, cy, cm : mod(chir, 2), candidates, i, ce, result : 0],
    candidates : ?gethash(fp, cell_hash, []),
    if length(candidates) = 0 then return(0),
    cx : qcanon(c[1]),
    cy : qcanon(c[2]),
    for i in candidates do (
        ce : cell_center[i],
        if qeq(ce[1], cx) and qeq(ce[2], cy)
           and cell_chir[i] = cm
           and cell_sheet[i] = s
        then (result : i, return(result))),
    result) $

/* Find-or-create. */
get_cell(c, chir, s) := block(
    [id : find_cell(c, chir, s)],
    if id = 0 then add_cell(c, chir, s) else id) $

/* Add an undirected edge. */
add_edge(i, j) := block(
    [],
    if not member(j, nbrs[i]) then
        nbrs[i] : endcons(j, nbrs[i]),
    if not member(i, nbrs[j]) then
        nbrs[j] : endcons(i, nbrs[j])) $

/* Reflection of n-gon A's center across the midpoint of its k-th edge
    gives the center of the neighbor sharing that edge.  The neighbor's
    chirality is the flip of A's chirality (for odd n; identical for
    even n).  This function returns just the center. */
reflected_neighbor_center(cx, cy, chir, k) := block(
    [m : edge_midpoint(cx, cy, chir, k)],
    [qcanon(2*m[1] - cx), qcanon(2*m[2] - cy)]) $

/* Generate the neighbor of cell i across its k-th edge, with sheet
    transition tau (an integer added to the current sheet index).
    The transition rule tau_rule(i, k) is a parameter of the experiment. */

/* Default transition rule: every (n_int)-th edge (by index parity) is a
    vortex edge contributing +1 to the sheet index; others contribute 0.
    For n=5 this reproduces the original "every3" didactic rule when
    combined with the (i+k) mod 3 test.  For general n we use a
    period-n_int rule: tau = 1 iff (i+k) mod n_int = 0. */
tau_rule_every3(i, k) :=
     if mod(i + k, 3) = 0 then 1 else 0 $
/* General period-n rule (replaces every3 for n != 5). */
tau_rule_everyn(i, k) :=
      if mod(i + k, n_int) = 0 then 1 else 0 $
tau_rule_signed3(i, k) :=
     if mod(i + k, 3) = 0 then 1
     elseif mod(i + k, 3) = 1 then -1
     else 0 $
/* General signed-n rule. */
tau_rule_signedn(i, k) :=
      if mod(i + k, n_int) = 0 then 1
      elseif mod(i + k, n_int) = 1 then -1
      else 0 $
/* The cap-window rule needs `cell_center`, `cell_orient` and the
    `reflected_neighbor_center` / `in_cap_window` helpers; we define
    it as a forward declaration here and bind its body after Section 17
    has defined `in_cap_window`. */
tau_rule_cap(i, k) := tau_rule_every3(i, k) $   /* placeholder */
/* Live dispatcher.  Always reads TAU_MODE so it can be retargeted.
    For n != 5 the "every3" and "signed3" modes fall back to the
    general period-n variants so the cluster is non-trivial. */
tau_rule(i, k) :=
     if TAU_MODE = "signed3" then tau_rule_signed3(i, k)
      elseif TAU_MODE = "signedn" then tau_rule_signedn(i, k)
     elseif TAU_MODE = "cap"  then tau_rule_cap(i, k)
      elseif TAU_MODE = "everyn" then tau_rule_everyn(i, k)
      else (if n_int = 5 then tau_rule_every3(i, k)
            else tau_rule_everyn(i, k)) $

/* Build a neighbor of cell i across edge k, returning its ID. */
add_neighbor(i, k) := block(
    [c : cell_center[i], chir : cell_chir[i], s : cell_sheet[i],
     nc, ds, ns, nb_id, nchir],
    nc : reflected_neighbor_center(c[1], c[2], chir, k),
    nchir : flip_chir(chir),
    ds : tau_rule(i, k),
    ns : s + ds,
    nb_id : get_cell(nc, nchir, ns),
    add_edge(i, nb_id),
    nb_id) $

/* BFS-expand a cluster up to a given depth. */
expand_cluster(depth) := block(
    [frontier, next_frontier, d, i, k, _nb],
    frontier : makelist(ii, ii, 1, cell_count),
    for d : 1 thru depth do (
        next_frontier : [],
        for i in frontier do
             for k : 0 thru n_int - 1 do (
                _nb : add_neighbor(i, k),
                if not member(_nb, next_frontier)
                   and not member(_nb, frontier)
                then next_frontier : endcons(_nb, next_frontier)),
        frontier : next_frontier)) $

/* Initialize with the origin pentagon. */
origin_id : add_cell([0, 0], 0, 0) $
print("Section 3: created origin", N_GON, "-gon, id =", origin_id,
        "  (TAU_MODE =", TAU_MODE, ")")$
/* If TAU_MODE = "cap", we cannot expand yet because the acceptance
    window predicate `in_cap_window` is only defined in Section 17.
    We forward-define a minimal version here so the main cluster can
    be built up front; Section 17 will override it identically. */
if TAU_MODE = "cap" then (
     qfloat_pre(z) := float(ratsimp(expand(z))),
     frac_part_pre(x) := x - floor(x),
     phantom_proj_pre(c) := block(
          /* Use phi for n=5; for other n use 2*cos(2*pi/n) as the
             irrational projection constant. */
          [proj_const : if n_int = 5 then float(phi)
                        else float(2*cos(2*%pi/n_int)),
           px : frac_part_pre(qfloat_pre(c[1]) * proj_const),
           py : frac_part_pre(qfloat_pre(c[2]) * proj_const)],
         [px, py]),
     cap_window_threshold_pre : 0.30,
     in_cap_window_pre(c) := block(
         [p : phantom_proj_pre(c), dx, dy, r2, theta_cos],
         dx : p[1] - 0.5,
         dy : p[2] - 0.5,
         r2 : dx^2 + dy^2,
         if r2 < 1e-12 then return(true),
         theta_cos : (dx^2 - dy^2)/r2,
         is(5 * theta_cos^2 - 4 > -cap_window_threshold_pre * 4)),
     /* Rebind cap rule body to use the pre-versions. */
     tau_rule_cap(i, k) := block(
         [c1 : cell_center[i],
          c2 : reflected_neighbor_center(c1[1], c1[2], cell_chir[i], k),
          a, b],
         a : in_cap_window_pre(c1),
         b : in_cap_window_pre(c2),
         if a # b then 1 else 0)
) $

/* Expand to a cluster.  Depth 2 already produces ~30-40 cells;
    higher depths grow roughly geometrically. */
expand_cluster(BFS_DEPTH)$
print("Section 3: after BFS depth", BFS_DEPTH,
        ", cell_count =", cell_count,
        "  (N_GON =", N_GON, ")")$

/* Quick sanity dump of the first few cells. */
print("First 5 cells (id, chirality, sheet, #neighbors):")$
for i : 1 thru min(5, cell_count) do
    print("  ", i, " chir=", cell_chir[i],
           " sheet=", cell_sheet[i],
           " deg=", length(nbrs[i]),
           " (interior target:", n_int, ")") $

/* Bipartiteness sanity-check for odd n: every edge should connect
    chir=0 to chir=1.  For even n, all chir=0. */
block(
     [bipartite_violation : 0, mono_violation : 0, i, j],
     for i : 1 thru cell_count do
         for j in nbrs[i] do
             if i < j then (
                 if CHIRAL_ACTIVE then (
                     if cell_chir[i] = cell_chir[j] then
                         bipartite_violation : bipartite_violation + 1)
                 else (
                     if cell_chir[i] # 0 or cell_chir[j] # 0 then
                         mono_violation : mono_violation + 1)),
     if CHIRAL_ACTIVE then
         print("Bipartite check (odd n): same-chirality edges =",
               bipartite_violation, " (should be 0)")
     else
         print("Mono-chirality check (even n): non-zero chir =",
               mono_violation, " (should be 0)"))$

/* Degree statistics. */
deg_list : makelist(length(nbrs[i]), i, 1, cell_count) $
deg_mean : float(apply("+", deg_list) / cell_count) $
deg_max  : apply(max, deg_list) $
deg_min  : apply(min, deg_list) $
print("Degree stats: min =", deg_min, ", mean =", deg_mean,
       ", max =", deg_max,
       " (interior", N_GON, "-gons should have deg", n_int, ")")$

/* Per-chirality cell counts. */
if CHIRAL_ACTIVE then block(
     [c0 : 0, c1 : 0, i],
     for i : 1 thru cell_count do
         if cell_chir[i] = 0 then c0 : c0 + 1 else c1 : c1 + 1,
     print("Chirality distribution: up =", c0, ", down =", c1,
           " (bipartite ratio ~ 1 expected at large depth)"))$

/* Sheet distribution. */
sheet_set : sort(listify(setify(cell_sheet))) $
print("Sheets present in cluster:", sheet_set)$

/* ---------------------------------------------------------------------
   SECTION 4.  Graph Laplacian and spectral analysis
   ---------------------------------------------------------------------

   Build the adjacency matrix A and degree matrix D, then L = D - A.
   Compute eigenvalues numerically (the matrix is moderate sized, and
   entries are integers, so floating-point Jacobi/eig is fine).
   --------------------------------------------------------------------- */

N : cell_count $

/* Decide whether to run the eigendecomposition.  It is O(N^3) and
    can dominate the runtime for large clusters. */
eig_skipped : SKIP_EIG or N > EIG_MAX_N $
spec_gap : 0 $

if eig_skipped then (
     print("Section 4: skipping eigendecomposition",
           "(SKIP_EIG =", SKIP_EIG, ", N =", N,
           ", EIG_MAX_N =", EIG_MAX_N, ")")
) else (
     /* Load lapack for fast numerical eigenvalues. */
     load("lapack"),

     /* Build adjacency matrix as a numerical matrix for eigenvalue work. */
     build_adjacency() := block(
         [A : zeromatrix(N, N), i, j],
         for i : 1 thru N do
             for j in nbrs[i] do
                 A[i, j] : 1,
         A),

     A_mat : build_adjacency(),
     D_diag : makelist(length(nbrs[i]), i, 1, N),
     D_mat  : apply(diag_matrix, D_diag),
     L_mat  : D_mat - A_mat,

     /* Check symmetry. */
     sym_err : lmax(flatten(args(L_mat - transpose(L_mat)))),
     print("Section 4: Laplacian symmetry residual =", sym_err),
     if sym_err # 0 then error("Laplacian not symmetric!"),

     /* Row sums of L should be zero (kernel contains all-ones). */
     rowsums : makelist(apply("+", L_mat[i]), i, 1, N),
     rs_max : lmax(map(abs, rowsums)),
     print("Laplacian row-sum max |.| =", rs_max, " (should be 0)"),
     if rs_max # 0 then error("Laplacian rows do not sum to 0"),

     /* Numerical eigenvalues. */
     L_float : float(L_mat),

     /* Use LAPACK dgeev for fast numerical eigenvalues; fall back to
        symbolic eigenvalues() if dgeev is unavailable. */
     eig_flat : [],
     if ?fboundp('dgeev) then block(
         [res, evs],
         res : dgeev(L_float),
         evs : res[1],
         /* evs is a list of (possibly complex) eigenvalues; take real parts. */
         eig_flat : sort(map(lambda([z], float(realpart(z))), evs)))
     else block(
         [eigs, eig_vals, eig_mults, k, m],
         eigs : eigenvalues(L_float),
         eig_vals : eigs[1],
         eig_mults : eigs[2],
         for k : 1 thru length(eig_vals) do
             for m : 1 thru eig_mults[k] do
                 eig_flat : endcons(float(eig_vals[k]), eig_flat),
         eig_flat : sort(eig_flat)),

     print("Number of eigenvalues:", length(eig_flat),
           " (expected N =", N, ")"),
     print("Smallest 5 eigenvalues:",
           makelist(eig_flat[k], k, 1, min(5, length(eig_flat)))),
     print("Largest 3 eigenvalues:",
           makelist(eig_flat[length(eig_flat) - k + 1], k, 1,
                    min(3, length(eig_flat)))),

     /* Spectral gap = smallest positive eigenvalue. */
     for lam in eig_flat do
         if spec_gap = 0 and lam > 1e-9 then spec_gap : lam,
     print("Spectral gap (algebraic connectivity) =", spec_gap),

     /* Crude DOS-based spectral dimension estimate:
        count eigenvalues in [0, lambda_max * frac] and fit log-log.
        rho(lambda) ~ lambda^(d_spec/2 - 1) means
        N(<=lambda) ~ lambda^(d_spec/2).                              */
     lam_max : last(eig_flat),
     fractions : [0.05, 0.10, 0.20, 0.30, 0.40],
     cdf_data : [],
     for f in fractions do block(
         [thr : f * lam_max, cnt : 0],
         for lam in eig_flat do if lam <= thr then cnt : cnt + 1,
         cdf_data : endcons([thr, cnt], cdf_data)),
     print("Spectral CDF samples [lambda, N(<=lambda)]:"),
     for pt in cdf_data do print("  ", pt),

      /* Least-squares log-log fit over ALL CDF samples (more robust
         than a 2-point slope). */
      if length(cdf_data) >= 2 then block(
          [xs : [], ys : [], pt, slope_pair, slope, intercept],
          for pt in cdf_data do
              if first(pt) > 0 and second(pt) > 0 then (
                  xs : endcons(float(log(first(pt))),  xs),
                  ys : endcons(float(log(second(pt))), ys)),
          if length(xs) >= 2 then (
              slope_pair : log_log_fit_basic(xs, ys),
              slope     : slope_pair[1],
              intercept : slope_pair[2],
              print("Spectral-CDF least-squares slope ~", slope,
                    "  => d_spec_estimate (DOS) ~", 2*slope,
                    "  (log-C =", intercept, ")"),
              d_spec_dos : 2*slope)
          else print("Spectral CDF too sparse for slope fit."))
     else
         print("Spectral CDF too sparse for a slope fit (small cluster).")
) $
/* Default if eig step was skipped. */
if not(?boundp('d_spec_dos)) then d_spec_dos : 0.0 $

/* ---------------------------------------------------------------------
   SECTION 5.  BFS volume growth: connectivity dimension d_eff
   --------------------------------------------------------------------- */

bfs_volumes(root) := block(
    [visited : makelist(false, ii, 1, N),
     dist    : makelist(-1, ii, 1, N),
     queue, v, j, max_d : 0, sizes],
    visited[root] : true,
    dist[root] : 0,
    queue : [root],
    while length(queue) > 0 do (
        v : first(queue),
        queue : rest(queue),
        for j in nbrs[v] do
            if not visited[j] then (
                visited[j] : true,
                dist[j] : dist[v] + 1,
                if dist[j] > max_d then max_d : dist[j],
                queue : endcons(j, queue))),
    sizes : makelist(0, ii, 0, max_d),
    for ii : 1 thru N do
        if dist[ii] >= 0 then
            sizes[dist[ii] + 1] : sizes[dist[ii] + 1] + 1,
    /* Convert per-shell counts to cumulative N(<=r). */
    for r : 2 thru length(sizes) do
        sizes[r] : sizes[r] + sizes[r-1],
    sizes) $

vols : bfs_volumes(origin_id) $
print("BFS cumulative volumes N(<=r) from origin:")$
for r : 1 thru length(vols) do
    print("  r =", r - 1, ": N =", vols[r])$

/* Fit d_eff from log N vs log r.  We do BOTH:
      (a) the "interior" fit r in [1, R-1] (skip origin and outermost
          shell), which is the canonical choice;
      (b) the "full" fit r in [1, R], for comparison.
    Reporting both surfaces boundary sensitivity. */
d_eff_est : 2.0 $
d_eff_full : 2.0 $
if length(vols) >= 4 then block(
     [r_lo : 2, r_hi : length(vols) - 1,
      x : [], y : [], fit, slope, intercept],
     for r : r_lo thru r_hi do (
         x : endcons(float(log(r - 1)), x),
         y : endcons(float(log(vols[r])), y)),
     fit : log_log_fit_basic(x, y),
     slope     : fit[1],
     intercept : fit[2],
     print("Log-log fit (interior, r in [", r_lo - 1, ",", r_hi - 1, "]):"),
     print("  d_eff estimate =", slope),
     print("  prefactor log C =", intercept,
           "  =>  C =", float(exp(intercept))),
     d_eff_est : slope)
else
     print("Cluster too small for reliable interior d_eff fit.") $

if length(vols) >= 3 then block(
     [x : [], y : [], fit, r],
     for r : 2 thru length(vols) do (
         x : endcons(float(log(r - 1)), x),
         y : endcons(float(log(vols[r])), y)),
     fit : log_log_fit_basic(x, y),
     print("Log-log fit (full, r in [1,", length(vols) - 1, "]):"),
     print("  d_eff (full) =", fit[1],
           "  log-C =", fit[2]),
     d_eff_full : fit[1]) $

/* ---------------------------------------------------------------------
   SECTION 6.  Random-walk simulation: d_w and d_spec
   ---------------------------------------------------------------------

   Run M random walks from the origin, recording:
     * Mean-squared graph-distance from start at each step
       (using the precomputed BFS distance table as a proxy for
        embedded distance; this is a reasonable scalar measure on
        irregular graphs).
     * Return frequency to the origin at even times t = 2, 4, 6,...

   Fit:
     <d(X_t, x_0)^2> ~ t^(2/d_w)
     P_0(t)        ~ t^(-d_spec/2)
   --------------------------------------------------------------------- */

/* Precompute BFS distance from origin to every node. */
bfs_dist(root) := block(
    [visited : makelist(false, ii, 1, N),
     dist    : makelist(-1, ii, 1, N),
     queue, v, j],
    visited[root] : true,
    dist[root] : 0,
    queue : [root],
    while length(queue) > 0 do (
        v : first(queue),
        queue : rest(queue),
        for j in nbrs[v] do
            if not visited[j] then (
                visited[j] : true,
                dist[j] : dist[v] + 1,
                queue : endcons(j, queue))),
    dist) $

dist_from_origin : bfs_dist(origin_id) $

/* Single random walk: returns list of node IDs visited, length T+1. */
random_walk(start, T) := block(
    [path : [start], v : start, nb, r, idx],
    for t : 1 thru T do (
        nb : nbrs[v],
        if length(nb) = 0 then return(path),
        r : random(length(nb)),
        v : nb[r + 1],
        path : endcons(v, path)),
    path) $

M_walks : M_WALKS $
T_steps : T_STEPS $

print("Section 6: running", M_walks, "random walks of length", T_steps,
      "from origin id =", origin_id)$

/* Accumulators. */
msd_sum : makelist(0, t, 0, T_steps) $
ret_cnt : makelist(0, t, 0, T_steps) $

for w : 1 thru M_walks do block(
    [path : random_walk(origin_id, T_steps), t, v, d],
    for t : 0 thru T_steps do (
        v : path[t + 1],
        d : dist_from_origin[v],
        if d < 0 then d : 0,
        msd_sum[t + 1] : msd_sum[t + 1] + d^2,
        if v = origin_id then
            ret_cnt[t + 1] : ret_cnt[t + 1] + 1)) $

msd : makelist(float(msd_sum[t + 1] / M_walks), t, 0, T_steps) $
p0  : makelist(float(ret_cnt[t + 1] / M_walks), t, 0, T_steps) $

/* Guarded prints: only access indices that exist for this T_steps. */
block(
     [sample_ts : [1, 5, 10, 20], t, idx, out : []],
     for t in sample_ts do (
         idx : t + 1,
         if idx <= length(msd) then
             out : endcons([t, msd[idx]], out)),
     print("MSD samples [t, <d^2>]:", out))$
block(
     [sample_ts : [2, 4, 10, 20], t, idx, out : []],
     for t in sample_ts do (
         idx : t + 1,
         if idx <= length(p0) then
             out : endcons([t, p0[idx]], out)),
     print("P_0 samples [t, P_0(t)]:", out))$

/* Fit d_w from log <Delta x^2> vs log t over the EARLY-TIME window
    [MSD_FIT_LO, MSD_FIT_HI] to avoid the boundary plateau. */
log_log_fit(xs, ys) := log_log_fit_basic(xs, ys) $

/* d_w from MSD slope = 2/d_w  =>  d_w = 2/slope.
    Early-time fit. */
msd_x : [] $
msd_y : [] $
for t : MSD_FIT_LO thru MSD_FIT_HI do
    if msd[t + 1] > 0 then (
        msd_x : endcons(float(log(t)), msd_x),
        msd_y : endcons(float(log(msd[t + 1])), msd_y)) $
d_w_value : 2.0 $

if length(msd_x) >= 3 then block(
     [fit : log_log_fit(msd_x, msd_y), msd_slope],
    msd_slope : fit[1],
     print("MSD early-time log-log slope =", msd_slope,
          "  =>  d_w estimate =",
          if abs(msd_slope) > 1e-6 then float(2/msd_slope) else "n/a"),
     if abs(msd_slope) > 1e-6 then d_w_value : float(2/msd_slope))
else

     print("Too few MSD data points for d_w fit.") $

/* Late-time MSD slope (diagnostic: should be ~ 0 if saturated). */
msd_x2 : [] $
msd_y2 : [] $
for t : max(MSD_FIT_HI + 1, 2) thru T_steps do
     if msd[t + 1] > 0 then (
         msd_x2 : endcons(float(log(t)), msd_x2),
         msd_y2 : endcons(float(log(msd[t + 1])), msd_y2)) $
if length(msd_x2) >= 3 then block(
     [fit : log_log_fit(msd_x2, msd_y2)],
     print("MSD late-time log-log slope =", fit[1],
           "  (near 0 => boundary saturation)")) $

/* d_spec from P_0 slope = -d_spec/2, restricted to early even times. */
p0_x : [] $
p0_y : [] $
for t : P0_FIT_LO step 2 thru P0_FIT_HI do
    if p0[t + 1] > 0 then (
        p0_x : endcons(float(log(t)), p0_x),
        p0_y : endcons(float(log(p0[t + 1])), p0_y)) $
d_spec_value : 0.0 $

if length(p0_x) >= 3 then block(
     [fit : log_log_fit(p0_x, p0_y), p0_slope],
    p0_slope : fit[1],
     print("P_0 early-time log-log slope =", p0_slope,
          "  =>  d_spec estimate =", -2*p0_slope),
    d_spec_value : -2*p0_slope)
else
     print("Too few P_0 data points (small cluster) -- using AO fallback.")$

print("------------------------------------------------------------")$
/* ---------------------------------------------------------------------
   SECTION 7.  Alexander-Orbach cross-check
   --------------------------------------------------------------------- */

print("------------------------------------------------------------")$
print("Dimension estimates summary:")$
print("  d_eff   (BFS volume growth) ~", d_eff_est)$
print("  d_eff   (BFS, full range)   ~", d_eff_full)$
print("  d_w     (MSD scaling)       ~", d_w_value)$
print("  d_spec  (P_0 decay, early)  ~", d_spec_value)$
if not eig_skipped then
     print("  d_spec  (DOS log-log)       ~", d_spec_dos)$

if d_w_value > 0 then block(
    [d_spec_AO : float(2 * d_eff_est / d_w_value)],
    print("  d_spec  (Alexander-Orbach 2*d_eff/d_w) ~", d_spec_AO),
    if d_spec_value > 0 then
        print("  Direct vs AO discrepancy:",
              abs(d_spec_value - d_spec_AO))) $
/* Consistency-check ordering: paper predicts d_spec < d_eff. */
if d_spec_dos > 0 and d_eff_est > 0 then (
     if d_spec_dos < d_eff_est then
         print("OK: d_spec(DOS) < d_eff(BFS), consistent with sub-diffusion.")
     else
         print("WARNING: d_spec(DOS) >= d_eff(BFS); not sub-diffusive."))$
/* Paper regime test:  2 < d_eff < 3. */
if d_eff_est > 2 and d_eff_est < 3 then
     print("OK: d_eff in (2, 3), inside paper's predicted fractional window.")
else
     print("Note: d_eff outside (2,3); cluster may be too small.")$

print("Note: these are small-cluster estimates; quantitative agreement")$
print("with the paper's predicted regime 2 < d_eff < 3 requires larger")$
print("clusters and the cut-and-project window for proper local finiteness.")$

/* ---------------------------------------------------------------------
   SECTION 8.  Holonomy experiments
   ---------------------------------------------------------------------

   expansion is non-trivial (every 3rd edge contributes +1), any loop
   enclosing the origin can show net holonomy.

    Concretely: we look for 3-cycles through the origin and report
    the raw holonomy and its reduction mod each fiber group.
   --------------------------------------------------------------------- */

/* Recover the sheet shift along a directed edge (i -> j). */
edge_sheet_shift(i, j) := cell_sheet[j] - cell_sheet[i] $

/* Total holonomy along a node sequence. */
loop_holonomy(seq) := block(
    [tot : 0, k],
    for k : 1 thru length(seq) - 1 do
        tot : tot + edge_sheet_shift(seq[k], seq[k + 1]),
    tot) $

/* Reduce holonomy into Z_n. */
holonomy_mod(seq, n) := mod(loop_holonomy(seq), n) $

/* Find a small closed loop: walk from origin to a neighbor n_a,
   to a 2-step neighbor n_ab, and (if possible) back to origin via
   a different edge. */
find_small_loop() := block(
    [a, b, na, nb, common, loop_found : false, loop],
    for a in nbrs[origin_id] do (
        if loop_found then return(loop),
        na : nbrs[a],
        for b in na do (
            if loop_found then return(loop),
            if b # origin_id then (
                nb : nbrs[b],
                if member(origin_id, nb) then (
                    loop : [origin_id, a, b, origin_id],
                    loop_found : true,
                    return(loop))))),
    if loop_found then loop else []) $

small_loop : find_small_loop() $
if length(small_loop) > 0 then block(
     [h_total, h_reductions],
    h_total : loop_holonomy(small_loop),
    print("Section 8: small loop found:", small_loop),
    print("  raw holonomy (sum of sheet shifts) =", h_total),
     for fg in FIBER_GROUPS_DEFAULT do block(
         [hmod : holonomy_mod(small_loop, fg)],
         print("  Z_", fg, " reduction =", hmod,
               if hmod # 0 then "  (non-trivial)"
                            else "  (trivial)")))
else
     print("Section 8: no 3-cycle through origin in cluster.")$
/* Longer-loop holonomy survey: look for 4- and 5-cycles through the
     origin, count how many have non-trivial holonomy for each fiber group. */
find_cycles_through_origin(maxlen) := block(
     [cycles : [], v1, v2, v3, v4],
     /* 4-cycles: origin -> a -> b -> c -> origin, a,b,c distinct */
     for v1 in nbrs[origin_id] do
         for v2 in nbrs[v1] do
             if v2 # origin_id then
                 for v3 in nbrs[v2] do
                     if v3 # v1 and v3 # origin_id
                        and member(origin_id, nbrs[v3]) then
                         cycles : endcons(
                             [origin_id, v1, v2, v3, origin_id],
                             cycles),
     if maxlen >= 5 then
         /* 5-cycles */
         for v1 in nbrs[origin_id] do
             for v2 in nbrs[v1] do
                 if v2 # origin_id then
                     for v3 in nbrs[v2] do
                         if v3 # v1 and v3 # origin_id then
                             for v4 in nbrs[v3] do
                                 if v4 # v2 and v4 # v1 and v4 # origin_id
                                    and member(origin_id, nbrs[v4]) then
                                     cycles : endcons(
                                         [origin_id, v1, v2, v3, v4,
                                          origin_id],
                                         cycles),
     cycles) $
long_cycles : find_cycles_through_origin(5) $
print("Longer cycles through origin (lengths 4-5):",
       length(long_cycles), "found.")$
if length(long_cycles) > 0 then block(
      [hcounts, cyc, raw, samples, fg, k],
      hcounts : makelist(0, k, 1, length(FIBER_GROUPS_DEFAULT)),
     for cyc in long_cycles do (
          raw : loop_holonomy(cyc),
          for k : 1 thru length(FIBER_GROUPS_DEFAULT) do (
              fg : FIBER_GROUPS_DEFAULT[k],
              if mod(raw, fg) # 0 then
                  hcounts[k] : hcounts[k] + 1)),
      for k : 1 thru length(FIBER_GROUPS_DEFAULT) do
          print("  Z_", FIBER_GROUPS_DEFAULT[k],
                " non-trivial holonomy loops:", hcounts[k],
                "/", length(long_cycles)),
      /* Show up to 3 examples with non-trivial Z_2 holonomy (or Z_n). */
     samples : 0,
     for cyc in long_cycles do
          if samples < 3 and holonomy_mod(cyc, n_int) # 0 then (
             print("  example spinor loop:", cyc,
                   "  raw =", loop_holonomy(cyc),
                    "  Z_2 =", holonomy_mod(cyc, 2),
                    "  Z_n =", holonomy_mod(cyc, n_int)),
             samples : samples + 1))$

/* Sweep over a longer loop: BFS shell-2 cells reachable from origin
   and back.  Just illustrative -- counts vortex edges traversed. */
n_vortex_edges_in_cluster : 0 $
for i : 1 thru N do
    for j in nbrs[i] do
        if i < j and edge_sheet_shift(i, j) # 0 then
            n_vortex_edges_in_cluster :
                n_vortex_edges_in_cluster + 1 $
print("Vortex edges in cluster (sheet shift != 0):",
      n_vortex_edges_in_cluster)$
print("Total edges in cluster:",
      apply("+", deg_list) / 2)$
print("Vortex fraction =",
      float(n_vortex_edges_in_cluster / (apply("+", deg_list) / 2)))$
/* Per-sheet vortex breakdown. */
print("Per-sheet cell counts:")$
for s in sheet_set do block(
     [cnt : 0],
     for i : 1 thru N do
         if cell_sheet[i] = s then cnt : cnt + 1,
     print("  sheet", s, ":", cnt, "cells"))$

/* ---------------------------------------------------------------------
   SECTION 9.  Cellular automaton dynamics
   ---------------------------------------------------------------------

    Define a binary outer-totalistic rule on the n-regular graph:
     New state = f(self, sum_of_neighbors)
    The default rule is B2/S12 for n <= 6 and B3/S23 for n > 6,
    scaled to the degree of the graph.  Initialize with a small "seed"
    at the origin and a couple of neighbors, then evolve T_ca steps.
   --------------------------------------------------------------------- */

/* Default rule scaled to n_int neighbors.
    Birth threshold b_thresh ~ n_int/3 (rounded), survival window [b_thresh-1, b_thresh].
    For n=5: b_thresh=2 => B2/S12 (original rule).
    For n=6: b_thresh=2 => B2/S12.
    For n=8: b_thresh=3 => B3/S23.                                     */
ca_b_thresh : max(1, round(n_int / 3)) $
ca_rule(self_state, nbr_sum) := block(
     [b : ca_b_thresh],
     if self_state = 1 then
         (if nbr_sum = b - 1 or nbr_sum = b then 1 else 0)
     else
         (if nbr_sum = b then 1 else 0)) $
print("Section 9: CA default rule B", ca_b_thresh, "/S",
       ca_b_thresh - 1, ca_b_thresh,
       "  (n_int =", n_int, ")")$

/* Initial state: origin + first neighbor alive, rest dead. */
state : makelist(0, ii, 1, N) $
state[origin_id] : 1 $
if length(nbrs[origin_id]) >= 1 then
    state[nbrs[origin_id][1]] : 1 $
if length(nbrs[origin_id]) >= 2 then
    state[nbrs[origin_id][2]] : 1 $

initial_pop : apply("+", state) $
print("Section 9: CA initial population =", initial_pop)$

/* Step the CA. */
ca_step(s) := block(
    [new_s : makelist(0, ii, 1, N), i, nsum],
    for i : 1 thru N do (
        nsum : apply("+", map(lambda([j], s[j]), nbrs[i])),
        new_s[i] : ca_rule(s[i], nsum)),
    new_s) $

T_ca : T_CA $
pop_history : [initial_pop] $
for t : 1 thru T_ca do (
    state : ca_step(state),
    pop_history : endcons(apply("+", state), pop_history)) $

print("CA population history (t = 0..", T_ca, "):")$
for t : 0 thru T_ca do
    print("  t =", t, " population =", pop_history[t + 1])$

final_pop : last(pop_history) $
print("CA final population =", final_pop,
      if final_pop = 0 then "  (extinct)"
      else if final_pop = initial_pop then "  (still life)"
      else "  (active)")$

/* Distribution of final live cells across sheets. */
live_per_sheet : [] $
for s in sheet_set do block(
    [cnt : 0],
    for i : 1 thru N do
        if state[i] = 1 and cell_sheet[i] = s then cnt : cnt + 1,
    live_per_sheet : endcons([s, cnt], live_per_sheet)) $
print("Live cells per sheet at t =", T_ca, ":", live_per_sheet)$

/* ---------------------------------------------------------------------
    SECTION 10.  Extended ruleset survey (B/S families)
    ---------------------------------------------------------------------
     We systematically sweep over a panel of outer-totalistic B/S rules
     on the n-regular(ish) n-gon graph, scoring each on:
      - whether the seed dies, stabilizes, oscillates, or grows;
      - the maximum and final population;
      - the period (if periodic);
      - sheet-spreading behavior.
     We test combinations B, S drawn from subsets of {0,..,n_int}
     from a curated list of "Life-like" candidates scaled to n_int.
    --------------------------------------------------------------------- */
print("============================================================")$
print("SECTION 10: Extended ruleset survey")$
print("============================================================")$
/* General outer-totalistic rule constructor.  B and S are lists of
    integer neighbor sums that trigger birth / survival. */
make_rule(B, S) := buildq([B, S],
     lambda([self_state, nbr_sum],
         if self_state = 1 then
             (if member(nbr_sum, S) then 1 else 0)
         else
             (if member(nbr_sum, B) then 1 else 0))) $
/* Step a state with a given rule function. */
ca_step_rule(s, rule_fn) := block(
     [new_s : makelist(0, ii, 1, N), i, nsum],
     for i : 1 thru N do (
         nsum : apply("+", map(lambda([j], s[j]), nbrs[i])),
         new_s[i] : rule_fn(s[i], nsum)),
     new_s) $
/* Generate a standard "blinker-style" seed: origin plus first 3 nbrs. */
make_seed_origin(k) := block(
     [s : makelist(0, ii, 1, N), nb : nbrs[origin_id], j],
     s[origin_id] : 1,
     for j : 1 thru min(k, length(nb)) do s[nb[j]] : 1,
     s) $
/* Run a rule on a seed for T steps, looking for cycles via state hash. */
run_rule_diagnose(B, S, seed, T) := block(
     [rule_fn : make_rule(B, S),
      state : seed, hist : [], pops : [], i, prev_idx,
      period : 0, transient : T, max_pop : 0, final_pop, fate],
     hist : [state],
     pops : [apply("+", state)],
     max_pop : pops[1],
     for i : 1 thru T do (
         state : ca_step_rule(state, rule_fn),
         pops  : endcons(apply("+", state), pops),
         if last(pops) > max_pop then max_pop : last(pops),
         /* cycle detect against previous states */
         prev_idx : 0,
         for k : 1 thru length(hist) do
             if hist[k] = state and prev_idx = 0 then prev_idx : k,
         if prev_idx > 0 then (
             period    : length(hist) - prev_idx + 1,
             transient : prev_idx - 1,
             return(0)),
         hist : endcons(state, hist)),
     final_pop : last(pops),
     fate : (
         if final_pop = 0 then "extinct"
         else if period = 1 then "still"
         else if period > 1 then concat("period-", period)
         else if final_pop > 3 * pops[1] then "growing"
         else "active"),
     [fate, period, transient, max_pop, final_pop, pops]) $
/* Curated set of B/S candidates.  On a 5-regular graph, neighbor sum
     is in 0..n_int (interior), so rules select subsets of {0,..,n_int}.
     We exclude B0 to avoid trivial boundary births.
     The panel is generated dynamically from the birth threshold b. */
block(
  [b : ca_b_thresh, h : max(1, round(n_int / 2))],
  rule_panel : [
      [[b],       [b-1, b]],           /* default rule */
      [[b],       [b, b+1]],           /* shifted survival */
      [[b+1],     [b, b+1]],           /* Conway-like B(b+1)/S(b,b+1) */
      [[b],       [b-1, b, b+1]],      /* generous survival */
      [[b+1],     [b-1, b, b+1]],      /* B(b+1)/S wide */
      [[b, b+1],  [b, b+1]],           /* symmetric */
      [[1],       [1, 2]],             /* replicator-style */
      [[1],       [1]],                /* pure replicator */
      [[b],       [b+1]],              /* minority */
      [[b+1],     [b+1]],              /* high-density */
      [[b, h],    [b-1, b, b+1]],      /* sparse+dense birth */
      [[h],       [h-1, h]],           /* high-density survival */
      [[b-1, b],  [b-1, b]],           /* low-threshold */
      [[b+1],     [b, b+1, b+2]],      /* wide survival */
      [[b],       makelist(j, j, 1, b+2)] /* generous */
  ]) $
/* Remove any rules with negative neighbor counts. */
rule_panel : sublist(rule_panel, lambda([r],
      every(lambda([x], x >= 0), r[1]) and
      every(lambda([x], x >= 0), r[2]))) $
/* Standardize the seed across the panel for comparability. */
panel_seed : make_seed_origin(2) $
panel_seed_pop : apply("+", panel_seed) $
print("Panel seed population =", panel_seed_pop)$
print("Panel run length T =", T_CA)$
print("")$
rule_results : [] $
for r in rule_panel do block(
     [B : r[1], S : r[2], res, label],
     res : run_rule_diagnose(B, S, panel_seed, T_CA),
     label : concat("B", apply(sconcat, B), "/S", apply(sconcat, S)),
     rule_results : endcons([label, B, S, res[1], res[2],
                             res[3], res[4], res[5]],
                            rule_results),
     print("  ", label,
           "  fate=", res[1],
           "  period=", res[2],
           "  transient=", res[3],
           "  max_pop=", res[4],
           "  final_pop=", res[5])) $
/* Classify the panel. */
n_extinct : 0 $
n_still   : 0 $
n_period  : 0 $
n_growing : 0 $
n_active  : 0 $
for r in rule_results do (
     if r[4] = "extinct"  then n_extinct : n_extinct + 1,
     if r[4] = "still"    then n_still   : n_still   + 1,
     if r[4] = "growing"  then n_growing : n_growing + 1,
     if r[4] = "active"   then n_active  : n_active  + 1,
     if not member(r[4], ["extinct", "still", "growing", "active"])
        then n_period : n_period + 1) $
print("")$
print("Panel classification:")$
print("  extinct =", n_extinct,
       "  still =", n_still,
       "  periodic =", n_period,
       "  growing =", n_growing,
       "  active =", n_active)$
/* Identify the most interesting rule (highest non-saturating max_pop
    that does not blow up beyond ~ N/2). */
best_rule : [] $
best_score : 0 $
for r in rule_results do block(
     [mp : r[7]],
     if mp > best_score and mp < N/2 and r[4] # "extinct" then (
         best_score : mp,
         best_rule  : r)) $
if length(best_rule) > 0 then
     print("Most active non-degenerate rule:", best_rule[1],
           " with max_pop =", best_rule[7],
           " fate=", best_rule[4])$
/* ---------------------------------------------------------------------
    SECTION 11.  Alternative tau-rules: holonomy and structure comparison
    ---------------------------------------------------------------------
     We rebuild small clusters under different vortex rules tau(i, k)
     and compare (generalized to n_int):
      - cell count after fixed BFS depth,
      - number of sheets reached,
      - vortex-edge fraction,
      - degree statistics,
       - non-trivial holonomy loop fraction in Z_2, Z_{n_int}, and others.
    --------------------------------------------------------------------- */
print("============================================================")$
print("SECTION 11: Alternative tau-rule survey")$
print("============================================================")$
/* Cluster builder parameterized by tau function. */
build_cluster_tau(tau_fn, depth) := block(
     [saved_count : cell_count, saved_center : cell_center,
      saved_chir : cell_chir, saved_sheet : cell_sheet,
      saved_nbrs : nbrs, saved_origin : origin_id,
     saved_tau : tau_rule, saved_hash : cell_hash,
      result, origin_id2],
     /* reset registry */
     cell_count : 0,
     cell_center : [], cell_chir : [], cell_sheet : [], nbrs : [],
    cell_hash : ?make\-hash\-table(),
     tau_rule(i, k) := apply(tau_fn, [i, k]),
     origin_id2 : add_cell([0, 0], 0, 0),
     expand_cluster(depth),
     result : [cell_count, copylist(cell_center), copylist(cell_chir),
               copylist(cell_sheet), copylist(nbrs), origin_id2],
     /* restore */
     cell_count  : saved_count,
     cell_center : saved_center,
     cell_chir   : saved_chir,
     cell_sheet  : saved_sheet,
     nbrs        : saved_nbrs,
     origin_id   : saved_origin,
    cell_hash   : saved_hash,
     tau_rule(i, k) := apply(saved_tau, [i, k]),
     result) $
/* Various tau-rule candidates. */
tau_none(i, k)     := 0 $
tau_every3(i, k)   := if mod(i + k, 3) = 0 then 1 else 0 $
tau_every2(i, k)   := if mod(i + k, 2) = 0 then 1 else 0 $
tau_every5(i, k)   := if mod(i + k, 5) = 0 then 1 else 0 $
tau_kparity(i, k)  := if mod(k, 2) = 0 then 1 else 0 $
tau_chiral(i, k)   := if mod(k, 5) <= 1 then 1 else 0 $
tau_signed(i, k)   := if mod(i + k, 3) = 0 then 1
                       elseif mod(i + k, 3) = 1 then -1
                       else 0 $
tau_fib(i, k)      := if member(mod(i + k, 8), [1, 2, 3, 5]) then 1 else 0 $
/* General period-n variants (always meaningful regardless of N_GON). */
tau_everyn_fn(i, k)  := if mod(i + k, n_int) = 0 then 1 else 0 $
tau_signedn_fn(i, k) := if mod(i + k, n_int) = 0 then 1
                          elseif mod(i + k, n_int) = 1 then -1
                          else 0 $
tau_kmodn(i, k)      := if mod(k, n_int) = 0 then 1 else 0 $
tau_chiralN(i, k)    := if mod(k, n_int) <= floor(n_int/3) then 1 else 0 $
tau_panel : [
     ["none      (flat)",     tau_none],
     ["every3    (default)",  tau_every3],
     ["every2",               tau_every2],
     ["every5",               tau_every5],
     ["k-parity",             tau_kparity],
     ["chiral",               tau_chiral],
     ["signed-3",             tau_signed],
      ["fibonacci-mod8",       tau_fib],
      ["every-n",              tau_everyn_fn],
      ["signed-n",             tau_signedn_fn],
      ["k-mod-n",              tau_kmodn],
      ["chiral-n",             tau_chiralN]
] $
/* For each tau rule we report key stats from a depth-3 cluster
    (kept smaller than the main cluster to keep this section snappy). */
TAU_SURVEY_DEPTH : min(BFS_DEPTH, 3) $
/* Helper: count vortex edges in a cluster snapshot. */
count_vortex_edges(centers, sheets, nbr_list, n_cells) := block(
     [v : 0, total : 0, i, j],
     for i : 1 thru n_cells do
         for j in nbr_list[i] do
             if i < j then (
                 total : total + 1,
                 if sheets[j] - sheets[i] # 0 then v : v + 1)),
         [v, total] $
/* Helper: enumerate 4- and 5-cycles through a given root in a snapshot. */
find_cycles_in_snapshot(root, nbr_list) := block(
     [cycles : [], v1, v2, v3, v4],
     for v1 in nbr_list[root] do
         for v2 in nbr_list[v1] do
             if v2 # root then
                 for v3 in nbr_list[v2] do
                     if v3 # v1 and v3 # root
                        and member(root, nbr_list[v3]) then
                         cycles : endcons([root, v1, v2, v3, root],
                                          cycles),
     for v1 in nbr_list[root] do
         for v2 in nbr_list[v1] do
             if v2 # root then
                 for v3 in nbr_list[v2] do
                     if v3 # v1 and v3 # root then
                         for v4 in nbr_list[v3] do
                             if v4 # v2 and v4 # v1 and v4 # root
                                and member(root, nbr_list[v4]) then
                                 cycles : endcons(
                                     [root, v1, v2, v3, v4, root],
                                     cycles),
     cycles) $
/* Holonomy of a sequence given a sheet vector. */
snapshot_holonomy(seq, sheets) := block(
     [tot : 0, k],
     for k : 1 thru length(seq) - 1 do
         tot : tot + (sheets[seq[k+1]] - sheets[seq[k]]),
     tot) $
tau_survey_results : [] $
for tp in tau_panel do block(
     [label : tp[1], tau_fn : tp[2], snap, nc, sheets, nbrlist, root,
      ve_pair, vortex_edges, total_edges, deg_l, sheet_count,
       cycles, hcounts, c, hh, k, fg],
     snap : build_cluster_tau(tau_fn, TAU_SURVEY_DEPTH),
     nc      : snap[1],
     sheets  : snap[4],
     nbrlist : snap[5],
     root    : snap[6],
     ve_pair : count_vortex_edges(snap[2], sheets, nbrlist, nc),
     vortex_edges : ve_pair[1],
     total_edges  : ve_pair[2],
     deg_l : makelist(length(nbrlist[i]), i, 1, nc),
     sheet_count : length(listify(setify(sheets))),
     cycles : find_cycles_in_snapshot(root, nbrlist),
      hcounts : makelist(0, k, 1, length(FIBER_GROUPS_DEFAULT)),
     for c in cycles do (
         hh : snapshot_holonomy(c, sheets),
          for k : 1 thru length(FIBER_GROUPS_DEFAULT) do (
              fg : FIBER_GROUPS_DEFAULT[k],
              if mod(hh, fg) # 0 then
                  hcounts[k] : hcounts[k] + 1)),
     print("  tau =", label,
           "  cells=", nc,
           "  sheets=", sheet_count,
           "  edges=", total_edges,
           "  vortex=", vortex_edges,
           "  vfrac=",
           if total_edges > 0 then float(vortex_edges/total_edges) else 0,
           "  meanDeg=",
           if nc > 0 then float(apply("+", deg_l) / nc) else 0,
           "  cycles=", length(cycles),
            "  holonomy_nontrivial=", hcounts,
            "  (groups=", FIBER_GROUPS_DEFAULT, ")"),
     tau_survey_results : endcons(
          append([label, nc, sheet_count, vortex_edges, total_edges,
                  length(cycles)], hcounts),
         tau_survey_results)) $
/* Identify the tau-rule with the richest holonomy structure. */
best_tau_label : "" $
best_tau_score : -1 $
for r in tau_survey_results do block(
      /* sum all holonomy counts (columns 7 onward) */
      [score : apply("+", rest(r, 6))],
     if score > best_tau_score then (
         best_tau_score : score,
         best_tau_label : r[1])) $
print("")$
print("Richest-holonomy tau-rule (sum of Z_2/Z_3/Z_5 non-trivial counts):",
       best_tau_label,
       "  score =", best_tau_score)$
/* ---------------------------------------------------------------------
    SECTION 12.  Extended holonomy: more fiber groups
    ---------------------------------------------------------------------
     Apply Z_m reductions for m in FIBER_GROUPS_DEFAULT to the long_cycles
     of the main cluster.  m = 2 is the spinor reduction; m = n_int is the
     anyonic one tied to n-gon symmetry; others are diagnostic.
    --------------------------------------------------------------------- */
print("============================================================")$
print("SECTION 12: Extended holonomy on main cluster")$
print("============================================================")$
fiber_groups : FIBER_GROUPS_DEFAULT $
print("Examining", length(long_cycles), "long cycles in main cluster.")$
if length(long_cycles) > 0 then block(
     [hcounts, n, cyc, raw, residue, dist],
     hcounts : makelist(0, k, 1, length(fiber_groups)),
     /* residue distributions: for each n, a list of length n */
     residue_dists : makelist(makelist(0, j, 1, fiber_groups[k]),
                              k, 1, length(fiber_groups)),
     for cyc in long_cycles do (
         raw : loop_holonomy(cyc),
         for k : 1 thru length(fiber_groups) do (
             n : fiber_groups[k],
             residue : mod(raw, n),
             residue_dists[k][residue + 1] :
                 residue_dists[k][residue + 1] + 1,
             if residue # 0 then hcounts[k] : hcounts[k] + 1)),
     for k : 1 thru length(fiber_groups) do
         print("  Z_", fiber_groups[k],
               ":  non-trivial =", hcounts[k], "/", length(long_cycles),
               "  residue distribution =", residue_dists[k]))
else
     print("(no long cycles to analyze)")$
/* Raw holonomy distribution. */
if length(long_cycles) > 0 then block(
     [raws : [], cyc],
     for cyc in long_cycles do raws : endcons(loop_holonomy(cyc), raws),
     print("Raw holonomy values (length", length(raws), "):"),
     print("  min =", apply(min, raws),
           "  max =", apply(max, raws),
           "  mean =", float(apply("+", raws) / length(raws))),
     /* histogram */
     block(
         [tab : []],
         for v in sort(listify(setify(raws))) do block(
             [cnt : 0],
             for r in raws do if r = v then cnt : cnt + 1,
             tab : endcons([v, cnt], tab)),
         print("  histogram [value, count] =", tab))) $
/* ---------------------------------------------------------------------
    SECTION 13.  Structural pattern analysis
    ---------------------------------------------------------------------
    We compute several graph-theoretic descriptors that are sensitive to
    the multi-sheeted construction:
      - clustering coefficient (local triangle density),
      - girth (length of shortest cycle through origin),
      - degree histogram,
      - inter-sheet edge count,
      - sheet-to-sheet transition matrix.
    --------------------------------------------------------------------- */
print("============================================================")$
print("SECTION 13: Structural patterns in main cluster")$
print("============================================================")$
/* Degree histogram. */
deg_hist : [] $
for d : 0 thru deg_max do block(
     [cnt : 0],
     for i : 1 thru N do
         if length(nbrs[i]) = d then cnt : cnt + 1,
     if cnt > 0 then deg_hist : endcons([d, cnt], deg_hist)) $
print("Degree histogram [deg, count]:")$
for h in deg_hist do print("  ", h)$
/* Local clustering coefficient.  For node i with neighbors N(i):
    c_i = (# edges among N(i)) / (|N(i)| choose 2).  Average over nodes
    with degree >= 2. */
clustering_coeffs : [] $
for i : 1 thru N do block(
     [ni : nbrs[i], di, edges_in : 0, j, kk],
     di : length(ni),
     if di >= 2 then (
         for j in ni do
             for kk in ni do
                 if j < kk and member(kk, nbrs[j]) then
                     edges_in : edges_in + 1,
         clustering_coeffs : endcons(
             float(edges_in / (di * (di - 1) / 2)),
             clustering_coeffs))) $
if length(clustering_coeffs) > 0 then
     print("Mean local clustering coefficient =",
           float(apply("+", clustering_coeffs)
                 / length(clustering_coeffs)),
           " over", length(clustering_coeffs), "nodes (deg >= 2)")
else
     print("No nodes with degree >= 2 for clustering.")$
/* Triangle count (= sum of edges among neighbors / 3). */
triangle_count : 0 $
for i : 1 thru N do
     for j in nbrs[i] do
         if j > i then
             for kk in nbrs[j] do
                 if kk > j and member(kk, nbrs[i]) then
                     triangle_count : triangle_count + 1 $
print("Triangle count in main cluster =", triangle_count)$
/* Girth at origin: shortest cycle returning to origin (length >= 3). */
girth_origin : 0 $
block([found : false, g],
     for g : 3 thru 8 do (
         if found then return(0),
         /* BFS-based search for cycles of length g through origin */
         block(
              [paths : [[origin_id]], paths2 : [], p, last_v, nb_v, ext, st],
              for st : 1 thru g do (
                 paths2 : [],
                 for p in paths do (
                     last_v : last(p),
                     for nb_v in nbrs[last_v] do (
                         /* allow returning to origin only on final step */
                          if st = g then (
                             if nb_v = origin_id and length(p) >= 3 then (
                                 girth_origin : g,
                                 found : true,
                                 return(0)))
                         else (
                             if not member(nb_v, p) and nb_v # origin_id then
                                 paths2 : endcons(endcons(nb_v, p), paths2)))),
                 if found then return(0),
                 paths : paths2)))) $
print("Girth (shortest cycle) through origin =",
       if girth_origin > 0 then girth_origin else "> 8") $
/* For odd n the dual graph is bipartite on chirality, so every cycle
    of odd length must close via a non-trivial sheet-shift sequence
    (i.e. it carries genuine monodromy and cannot be a pure same-sheet
    geometric loop).  Report this as a structural observation. */
if CHIRAL_ACTIVE and girth_origin > 0 then
     print("  Bipartite-chirality note: any odd-length cycle through",
           "origin carries non-zero net chirality flip; closure",
           "requires the sheet/holonomy degree of freedom.")$
/* Inter-sheet edges and sheet-to-sheet transition matrix. */
sheet_list : sort(listify(setify(cell_sheet))) $
n_sheets : length(sheet_list) $
sheet_index(s) := block(
     [idx : 0, k],
     for k : 1 thru n_sheets do
         if sheet_list[k] = s then idx : k,
     idx) $
trans_mat : zeromatrix(n_sheets, n_sheets) $
for i : 1 thru N do
     for j in nbrs[i] do
         if i < j then block(
             [si : sheet_index(cell_sheet[i]),
              sj : sheet_index(cell_sheet[j])],
             trans_mat[si, sj] : trans_mat[si, sj] + 1,
             if si # sj then
                 trans_mat[sj, si] : trans_mat[sj, si] + 1) $
print("Sheets present:", sheet_list)$
print("Sheet-to-sheet edge matrix (rows=sheet_list, cols=sheet_list):")$
for i : 1 thru n_sheets do
     print("  sheet", sheet_list[i], ":",
           makelist(trans_mat[i, j], j, 1, n_sheets))$
/* Inter-sheet edge count (should equal n_vortex_edges_in_cluster). */
inter_sheet_edges : 0 $
for i : 1 thru n_sheets do
     for j : i + 1 thru n_sheets do
         inter_sheet_edges : inter_sheet_edges + trans_mat[i, j] $
print("Inter-sheet (vortex) edges =", inter_sheet_edges,
       " (cross-check vs Section 8:", n_vortex_edges_in_cluster, ")")$
/* ---------------------------------------------------------------------
    SECTION 14.  Per-sheet sub-graph analysis
    ---------------------------------------------------------------------
    For each sheet, examine the induced sub-graph: how many cells, how
    many intra-sheet edges, mean degree, and BFS-volume slope (as a
    sheet-restricted d_eff estimate).
    --------------------------------------------------------------------- */
print("============================================================")$
print("SECTION 14: Per-sheet sub-graph statistics")$
print("============================================================")$
for s in sheet_list do block(
     [sheet_nodes : [], sheet_edges : 0, deg_sum : 0, i, j, intra_deg, k,
      sheet_seed],
     for i : 1 thru N do
         if cell_sheet[i] = s then
             sheet_nodes : endcons(i, sheet_nodes),
     if length(sheet_nodes) > 0 then (
         for i in sheet_nodes do (
             intra_deg : 0,
             for j in nbrs[i] do
                 if cell_sheet[j] = s then
                     intra_deg : intra_deg + 1,
             deg_sum : deg_sum + intra_deg),
         sheet_edges : deg_sum / 2,
         print("  sheet", s,
               ":  nodes=", length(sheet_nodes),
               "  intra-edges=", sheet_edges,
               "  meanIntraDeg=",
               float(deg_sum / length(sheet_nodes))))) $
/* Sheet-population sequence: how does cell count fall off with sheet
    index?  If geometric, we get a simple exponential decay rate. */
pop_by_sheet : [] $
for s in sheet_list do block(
     [cnt : 0],
     for i : 1 thru N do
         if cell_sheet[i] = s then cnt : cnt + 1,
     pop_by_sheet : endcons([s, cnt], pop_by_sheet)) $
print("Sheet-population sequence:", pop_by_sheet)$
if length(pop_by_sheet) >= 3 then block(
     [xs : [], ys : [], pt, fit],
     for pt in pop_by_sheet do
         if second(pt) > 0 then (
             xs : endcons(float(first(pt)), xs),
             ys : endcons(float(log(second(pt))), ys)),
     if length(xs) >= 3 then (
         fit : log_log_fit_basic(xs, ys),
         print("  log-pop vs sheet-index slope =", fit[1],
               "  => decay rate r =", float(exp(fit[1])),
               "  (geometric falloff if r < 1)"))) $
/* ---------------------------------------------------------------------
    SECTION 15.  Glider / oscillator hunt under multiple seeds
    ---------------------------------------------------------------------
    Re-run a small set of promising rules on several distinct seeds and
    record any periodic orbits with period > 1.  We also test whether
    any periodic pattern has a non-zero "center-of-mass drift" across
    its period, which would indicate glider-like translation in the
    BFS-distance metric.
    --------------------------------------------------------------------- */
print("============================================================")$
print("SECTION 15: Glider / oscillator hunt")$
print("============================================================")$
/* Pick the top 3 rules by max_pop among non-extinct, non-growing. */
promising_rules : [] $
for r in rule_results do
     if r[4] # "extinct" and r[4] # "growing"
        and length(promising_rules) < 5 then
         promising_rules : endcons([r[2], r[3], r[1]], promising_rules) $
print("Trying", length(promising_rules),
       "rules x several seed shapes.")$
/* Seed shapes: single, pair, triple, 5-petal (all 5 nbrs of origin). */
make_seed_shape(shape) := block(
     [s : makelist(0, ii, 1, N), nb : nbrs[origin_id], j],
     if shape = "single" then s[origin_id] : 1
     elseif shape = "pair" then (
         s[origin_id] : 1,
         if length(nb) >= 1 then s[nb[1]] : 1)
     elseif shape = "triple" then (
         s[origin_id] : 1,
         for j : 1 thru min(2, length(nb)) do s[nb[j]] : 1)
     elseif shape = "petal" then
         for j : 1 thru length(nb) do s[nb[j]] : 1
     elseif shape = "all5" then (
         s[origin_id] : 1,
         for j : 1 thru length(nb) do s[nb[j]] : 1),
     s) $
seed_shapes : ["single", "pair", "triple", "petal", "all5"] $
/* Compute COM-like statistic for a state: mean BFS distance of live
    cells from origin. */
live_mean_dist(state) := block(
     [tot : 0, cnt : 0, i],
     for i : 1 thru N do
         if state[i] = 1 then (
             tot : tot + dist_from_origin[i],
             cnt : cnt + 1),
     if cnt > 0 then float(tot / cnt) else 0) $
/* Track distance history alongside the state hash for glider detection. */
glider_hunt(B, S, seed, T) := block(
     [rule_fn : make_rule(B, S),
      state : seed, hist : [seed], dists : [live_mean_dist(seed)],
      i, prev_idx : 0, period : 0, transient : 0,
      d_amp : 0, d_drift : 0],
     for i : 1 thru T do (
         state : ca_step_rule(state, rule_fn),
         dists : endcons(live_mean_dist(state), dists),
         prev_idx : 0,
         for k : 1 thru length(hist) do
             if hist[k] = state and prev_idx = 0 then prev_idx : k,
         if prev_idx > 0 then (
             period : length(hist) - prev_idx + 1,
             transient : prev_idx - 1,
             return(0)),
         hist : endcons(state, hist)),
     if period > 1 then block(
         [seg : rest(dists, transient)],
         /* amplitude of distance oscillation over one period */
         d_amp : float(apply(max, seg) - apply(min, seg)),
         d_drift : float(last(seg) - first(seg))),
     [period, transient, d_amp, d_drift]) $
glider_summary : [] $
for rp in promising_rules do block(
     [B : rp[1], S : rp[2], label : rp[3], sh, seed, gh],
     for sh in seed_shapes do (
         seed : make_seed_shape(sh),
         gh : glider_hunt(B, S, seed, T_CA),
         glider_summary : endcons([label, sh, gh[1], gh[2], gh[3], gh[4]],
                                  glider_summary),
         if gh[1] > 1 then
             print("  ", label, " seed=", sh,
                   "  period=", gh[1],
                   "  transient=", gh[2],
                   "  d_amp=", gh[3],
                   "  d_drift=", gh[4]))) $
/* Count gliders: period > 1 AND d_amp > 0.5 (BFS-shells of motion). */
n_oscillators : 0 $
n_gliders     : 0 $
for g in glider_summary do (
     if g[3] > 1 then n_oscillators : n_oscillators + 1,
     if g[3] > 1 and g[5] > 0.5 then n_gliders : n_gliders + 1) $
print("")$
print("Glider hunt summary:")$
print("  trials =", length(glider_summary),
       "  oscillators =", n_oscillators,
       "  gliders =", n_gliders)$
/* ---------------------------------------------------------------------
    SECTION 16.  Long-loop holonomy enumeration
    ---------------------------------------------------------------------
     Enumerate longer simple cycles through the origin (up to
    LONG_LOOP_MAX steps), and also enumerate cycles anchored at
    *non-origin* vertices to expose monodromy that depends on the
    base point.
    --------------------------------------------------------------------- */
print("============================================================")$
print("SECTION 16: Long-loop holonomy enumeration")$
print("============================================================")$
/* DFS-based simple-cycle enumeration through a given root, up to
    a maximum length.  Returns a list of cycles (each a list of node
    IDs starting and ending at root).  Restricts to root being the
    minimum-ID vertex in the cycle to avoid trivial reorderings. */
enumerate_simple_cycles(root, maxlen, nbr_list) := block(
     [results : [], stack, visited, depth_limit : maxlen,
      v, nb, recur],
     /* iterative DFS via explicit recursion */
     recur(path, current_depth) := block(
         [last_v : last(path), nb, p_new, nx],
         for nx in nbr_list[last_v] do (
             if nx = root and current_depth >= 3 then
                 results : endcons(endcons(root, path), results)
             elseif nx > root and not member(nx, path)
                    and current_depth < depth_limit then (
                 p_new : endcons(nx, path),
                 recur(p_new, current_depth + 1)))),
     recur([root], 1),
     results) $
/* Enumerate cycles through origin up to LONG_LOOP_MAX steps. */
print("Enumerating simple cycles through origin up to length",
       LONG_LOOP_MAX, "...")$
all_cycles_origin : enumerate_simple_cycles(origin_id, LONG_LOOP_MAX, nbrs) $
print("Total cycles through origin found:", length(all_cycles_origin))$
/* Length distribution. */
if length(all_cycles_origin) > 0 then block(
     [len_hist : []],
     for L : 3 thru LONG_LOOP_MAX do block(
         [cnt : 0],
         for c in all_cycles_origin do
             if length(c) - 1 = L then cnt : cnt + 1,
         if cnt > 0 then len_hist : endcons([L, cnt], len_hist)),
     print("Cycle-length distribution [len, count]:"),
     for h in len_hist do print("  ", h)) $
/* Multi-group holonomy enumeration. */
long_fiber_groups : FIBER_GROUPS_DEFAULT $
if length(all_cycles_origin) > 0 then block(
     [hcounts, residue_dists, n, c, raw, residue, k],
     hcounts : makelist(0, k, 1, length(long_fiber_groups)),
     residue_dists : makelist(makelist(0, j, 1, long_fiber_groups[k]),
                              k, 1, length(long_fiber_groups)),
     for c in all_cycles_origin do (
         raw : loop_holonomy(c),
         for k : 1 thru length(long_fiber_groups) do (
             n : long_fiber_groups[k],
             residue : mod(raw, n),
             residue_dists[k][residue + 1] :
                 residue_dists[k][residue + 1] + 1,
             if residue # 0 then hcounts[k] : hcounts[k] + 1)),
     print("Holonomy by fiber group on all cycles through origin:"),
     for k : 1 thru length(long_fiber_groups) do
         print("  Z_", long_fiber_groups[k],
               " non-trivial =", hcounts[k], "/", length(all_cycles_origin),
               "  residue dist =", residue_dists[k]),
     /* Show a few example non-trivial Z_2 cycles, if any. */
     block(
         [shown : 0],
         for c in all_cycles_origin do
             if shown < 3 and mod(loop_holonomy(c), 2) # 0 then (
                 print("  example Z_2 non-trivial cycle of length",
                       length(c) - 1, ":", c,
                       " raw=", loop_holonomy(c)),
                 shown : shown + 1))) $
/* Now try cycles anchored at a non-origin vertex on a higher sheet,
    to expose base-point-dependent monodromy. */
non_origin_root : 0 $
for i : 1 thru N do
     if non_origin_root = 0 and cell_sheet[i] >= 2 and length(nbrs[i]) >= 3
        then non_origin_root : i $
if non_origin_root > 0 then block(
     [cycs, hcounts, n, c, raw, residue, k],
     print("Enumerating cycles through anchor node", non_origin_root,
           " (sheet=", cell_sheet[non_origin_root], ", deg=",
           length(nbrs[non_origin_root]), ") up to length",
           LONG_LOOP_MAX, "..."),
     cycs : enumerate_simple_cycles(non_origin_root, LONG_LOOP_MAX, nbrs),
     print("  cycles found:", length(cycs)),
     if length(cycs) > 0 then (
         hcounts : makelist(0, k, 1, length(long_fiber_groups)),
         for c in cycs do (
             raw : loop_holonomy(c),
             for k : 1 thru length(long_fiber_groups) do (
                 n : long_fiber_groups[k],
                 if mod(raw, n) # 0 then hcounts[k] : hcounts[k] + 1)),
         print("  Holonomy distribution at non-origin anchor:"),
         for k : 1 thru length(long_fiber_groups) do
             print("    Z_", long_fiber_groups[k],
                   " non-trivial =", hcounts[k], "/", length(cycs)))) $
/* ---------------------------------------------------------------------
    SECTION 17.  Cut-and-project acceptance window experiment
    ---------------------------------------------------------------------
     The didactic tau_rule is geometrically arbitrary.  The rigorous
     regime uses a cut-and-project window: lift the n-gon centroid into
     a higher-dimensional lattice, check whether its "perpendicular"
     component lies inside an acceptance window, and assign a vortex
     shift based on which window cell it falls in.
     We implement a *projected* version: the vortex rule is a function
     of the centroid's exact position, using the quasiperiodic projection
     constant 2*cos(2*pi/n) (= phi - 1 for n=5).
    --------------------------------------------------------------------- */
print("============================================================")$
print("SECTION 17: Cut-and-project acceptance-window tau-rule")$
print("============================================================")$
/* Projection of a Q(sqrt(5)) coordinate to an irrational "phantom"
    axis: x -> {x*phi} mod 1.  Two centroid coords give a 2D phantom
    point; the acceptance window is a small rectangle in that plane. */
/* Convert a Q(sqrt(5)) algebraic number to a floating-point value. */
qfloat(z) := float(ratsimp(expand(z))) $
/* Fractional part. */
frac_part(x) := x - floor(x) $
/* Phantom projection of a centroid using the n-gon's natural
    quasiperiodic constant: 2*cos(2*pi/n).  For n=5 this equals phi-1. */
proj_const_n : float(2*cos(2*%pi/n_int)) $
phantom_proj(c) := block(
      [px : frac_part(qfloat(c[1]) * proj_const_n),
       py : frac_part(qfloat(c[2]) * proj_const_n)],
     [px, py]) $
/* Cut-and-project tau rule: vortex iff phantom point falls in an
     n-fold-symmetric acceptance window.  We approximate the window
     by the inequality cos(n*theta) > -threshold, where theta is the
     polar angle of phantom_point - (0.5, 0.5).  For n=5 this gives
     the pentagonal window of the original paper. */
cap_window_threshold : 0.30 $
in_cap_window(c) := block(
     [p : phantom_proj(c), dx, dy, r2, theta_cos],
     dx : p[1] - 0.5,
     dy : p[2] - 0.5,
     r2 : dx^2 + dy^2,
     if r2 < 1e-12 then return(true),
      /* Use n-fold-modulated test via Chebyshev proxy for cos(n*theta).
         cos(2*theta) = (dx^2 - dy^2)/r2.  For n=5: T_5(cos(2t/5))
         approximation; for general n we use the same Chebyshev proxy
         scaled by n_int. */
      theta_cos : (dx^2 - dy^2)/r2,
      is(n_int * theta_cos^2 - (n_int - 1)
         > -cap_window_threshold * (n_int - 1))) $
/* Sample test: how many cells of the main cluster fall inside the
    acceptance window? */
cap_in_count : 0 $
for i : 1 thru N do
     if in_cap_window(cell_center[i]) then
         cap_in_count : cap_in_count + 1 $
print("Cells inside acceptance window:", cap_in_count, "/", N,
       " (fraction =", float(cap_in_count / N), ")")$
/* tau rule derived from acceptance window: shift +1 across edges
     where exactly one endpoint is inside the n-fold window. */
tau_cap(i, k) := block(
     [c1 : cell_center[i],
      c2 : reflected_neighbor_center(c1[1], c1[2], cell_orient[i], k),
      a, b],
     a : in_cap_window(c1),
     b : in_cap_window(c2),
     if a # b then 1 else 0) $
/* Build a cap-window cluster at slightly smaller depth and measure. */
CAP_DEPTH : min(BFS_DEPTH, 4) $
print("Building cap-window cluster at depth", CAP_DEPTH, "...")$
cap_snap : build_cluster_tau(tau_cap, CAP_DEPTH) $
cap_N : cap_snap[1] $
cap_sheets : cap_snap[4] $
cap_nbrs : cap_snap[5] $
cap_root : cap_snap[6] $
cap_sheet_set : sort(listify(setify(cap_sheets))) $
print("Cap-window cluster: N =", cap_N,
       ", sheets =", cap_sheet_set)$
/* If TAU_MODE = "cap", the main cluster IS the cap cluster, and
    we have already characterized it above.  But the dedicated cap
    block here provides a side-by-side measurement that is useful
    regardless of TAU_MODE. */
/* Per-sheet population and vortex edge count. */
cap_ve_pair : count_vortex_edges(cap_snap[2], cap_sheets, cap_nbrs, cap_N) $
print("  vortex edges =", cap_ve_pair[1], "/", cap_ve_pair[2],
       "  (fraction =",
       if cap_ve_pair[2] > 0 then float(cap_ve_pair[1]/cap_ve_pair[2]) else 0,
       ")")$
/* Holonomy on cap-window cluster. */
cap_cycles : enumerate_simple_cycles(cap_root, min(LONG_LOOP_MAX, 6),
                                       cap_nbrs) $
print("  cycles through cap_root:", length(cap_cycles))$
if length(cap_cycles) > 0 then block(
     [hcounts, n, c, raw, k],
     hcounts : makelist(0, k, 1, length(long_fiber_groups)),
     for c in cap_cycles do (
         raw : snapshot_holonomy(c, cap_sheets),
         for k : 1 thru length(long_fiber_groups) do (
             n : long_fiber_groups[k],
             if mod(raw, n) # 0 then hcounts[k] : hcounts[k] + 1)),
     print("  Holonomy by fiber group (cap-window cluster):"),
     for k : 1 thru length(long_fiber_groups) do
         print("    Z_", long_fiber_groups[k],
               " non-trivial =", hcounts[k], "/", length(cap_cycles))) $
/* BFS volume growth on the cap-window cluster to compare d_eff. */
cap_vols : block(
     [visited : makelist(false, ii, 1, cap_N),
      dist : makelist(-1, ii, 1, cap_N),
      queue : [cap_root], v, j, max_d : 0, sizes],
     visited[cap_root] : true, dist[cap_root] : 0,
     while length(queue) > 0 do (
         v : first(queue), queue : rest(queue),
         for j in cap_nbrs[v] do
             if not visited[j] then (
                 visited[j] : true,
                 dist[j] : dist[v] + 1,
                 if dist[j] > max_d then max_d : dist[j],
                 queue : endcons(j, queue))),
     sizes : makelist(0, ii, 0, max_d),
     for ii : 1 thru cap_N do
         if dist[ii] >= 0 then
             sizes[dist[ii] + 1] : sizes[dist[ii] + 1] + 1,
     for r : 2 thru length(sizes) do
         sizes[r] : sizes[r] + sizes[r-1],
     sizes) $
print("Cap-window BFS volumes:", cap_vols)$
if length(cap_vols) >= 4 then block(
     [xs : [], ys : [], r, fit],
     for r : 2 thru length(cap_vols) - 1 do (
         xs : endcons(float(log(r - 1)), xs),
         ys : endcons(float(log(cap_vols[r])), ys)),
     fit : log_log_fit_basic(xs, ys),
     print("  d_eff (cap-window, interior) =", fit[1])) $
/* ---------------------------------------------------------------------
    SECTION 18.  KPM-based spectral density approximation
    ---------------------------------------------------------------------
    For large N (e.g. the huge preset) the dense eigendecomposition is
    skipped.  The Kernel Polynomial Method (KPM) approximates the
    density of states rho(lambda) via Chebyshev moments of the
    rescaled Hamiltonian:
        mu_n = (1/N) tr T_n(L_tilde)
    estimated stochastically with random vectors.
    Here L_tilde = (L - a)/b is rescaled to [-1, 1].  Bound:
    lambda_max(L) <= 2 * deg_max.
    --------------------------------------------------------------------- */
print("============================================================")$
print("SECTION 18: KPM spectral density approximation")$
print("============================================================")$
/* Sparse matrix-vector product for L = D - A. */
sparse_Lv(v) := block(
     [result : makelist(0, ii, 1, N), i, j, dv],
     for i : 1 thru N do (
         dv : length(nbrs[i]) * v[i],
         for j in nbrs[i] do
             dv : dv - v[j],
         result[i] : dv),
     result) $
/* KPM rescaling: L_tilde = (L - a)/b, with a = lam_max/2, b = lam_max/2,
    so spec(L_tilde) subset [-1, 1].  Upper bound lam_max <= 2*deg_max. */
kpm_a : float(deg_max) $
kpm_b : float(deg_max) $
/* Apply L_tilde to vector v. */
kpm_Lt_v(v) := block(
     [Lv : sparse_Lv(v)],
     makelist((Lv[i] - kpm_a * v[i]) / kpm_b, i, 1, N)) $
/* Estimate Chebyshev moments mu_n via stochastic trace.
    mu_n approx (1/S) sum_{s=1..S} <z_s, T_n(L_tilde) z_s>,
    using the recursion T_0 = I, T_1 = L_tilde, T_{n+1} = 2 L_tilde T_n - T_{n-1}. */
kpm_estimate_moments(M, S) := block(
     [mu : makelist(0.0, n, 1, M), s, z, t0, t1, t2, n, dot],
     for s : 1 thru S do block(
         [z],
         z : makelist(if random(2) = 0 then 1.0 else -1.0, ii, 1, N),
         /* normalize:  <z,z> = N */
         t0 : z,
         t1 : kpm_Lt_v(t0),
         mu[1] : mu[1] + apply("+", t0*t0)/N,
         if M >= 2 then mu[2] : mu[2] + apply("+", t0*t1)/N,
         for n : 3 thru M do (
             t2 : 2 * kpm_Lt_v(t1) - t0,
             mu[n] : mu[n] + apply("+", t0*t2)/N,
             t0 : t1, t1 : t2)),
     makelist(mu[n]/S, n, 1, M)) $
/* Reconstruct DOS at points x in [-1+eps, 1-eps] using Jackson-damped
    Chebyshev series.  rho(x) approx (1/(pi sqrt(1-x^2))) *
    (mu_0 + 2 sum_{n>=1} g_n mu_n T_n(x))   where g_n is the Jackson kernel. */
jackson_g(n, M) := block(
     [Mp : M + 1],
     ((Mp - n)/Mp) * cos(%pi * n / Mp)
      + sin(%pi * n / Mp) * cot(%pi / Mp) / Mp) $
kpm_dos_at(x, mu) := block(
     [M : length(mu), s, n, T_prev : 1, T_curr : x, T_next, gv],
     s : mu[1],
     if M >= 2 then s : s + 2 * jackson_g(1, M) * mu[2] * x,
     for n : 3 thru M do (
         T_next : 2*x*T_curr - T_prev,
         gv : jackson_g(n - 1, M),
         s : s + 2 * gv * mu[n] * T_next,
         T_prev : T_curr, T_curr : T_next),
     s / (%pi * sqrt(max(1 - x^2, 1e-12)))) $
/* Run KPM and report estimated DOS at several points. */
print("Running KPM with M =", KPM_MOMENTS, "moments,",
       KPM_SAMPLES, "random samples...")$
kpm_mu : 0 $
kpm_run_ok : false $
errcatch(
     kpm_mu : kpm_estimate_moments(KPM_MOMENTS, KPM_SAMPLES),
     kpm_run_ok : true) $
if kpm_run_ok then (
     print("KPM moment summary: mu_0 =", kpm_mu[1],
           " (should be ~ 1.0)"),
     print("                    mu_1 =", kpm_mu[2],
           "  mu_2 =", if KPM_MOMENTS >= 3 then kpm_mu[3] else 0,
           "  mu_4 =", if KPM_MOMENTS >= 5 then kpm_mu[5] else 0),
     /* Sample the reconstructed DOS at a few points along the spectrum. */
     print("DOS samples [lambda, rho(lambda)]:"),
     block(
         [xs : [-0.95, -0.8, -0.5, -0.2, 0, 0.2, 0.5, 0.8, 0.95],
          xx, lam, rho],
         for xx in xs do (
             lam : float(kpm_a + xx * kpm_b),
             rho : float(kpm_dos_at(xx, kpm_mu)),
             print("  lam =", lam, "  rho_est =", rho))),
     /* Use the low-lambda tail to estimate d_spec from KPM.
        rho(lam) ~ lam^(d_spec/2 - 1) for small positive lam.
        We sample on a fine grid near the spectral edge and report
        slopes over multiple sub-windows to surface uncertainty. */
     block(
         [low_xs : [], low_ys : [], xx, lam, rho, fit, slope,
          sub_xs, sub_ys, sub_fit, w_lo, w_hi, slopes : [],
          k_pt : 0],
         for xx : -0.999 step 0.002 thru -0.80 do (
             lam : float(kpm_a + xx * kpm_b),
             /* shift origin so lam_0 (the smallest eigenvalue ~ 0) is at xx ~ -1 */
             rho : float(kpm_dos_at(xx, kpm_mu)),
             if lam > 1e-3 and rho > 1e-6 then (
                 low_xs : endcons(float(log(lam)), low_xs),
                 low_ys : endcons(float(log(rho)), low_ys))),
         print("KPM low-tail sample count =", length(low_xs)),
         if length(low_xs) >= 4 then (
             fit : log_log_fit_basic(low_xs, low_ys),
             slope : fit[1],
             print("KPM low-lambda log-log slope =", slope),
             print("  => d_spec_KPM (= 2*(slope+1)) ~", 2*(slope + 1)),
             d_spec_kpm : 2*(slope + 1),
             /* Sub-window slope sweep for uncertainty estimate. */
             block(
                 [n_low : length(low_xs), half, sub_fit2],
                 half : floor(n_low / 2),
                 if half >= 3 then (
                     sub_xs : makelist(low_xs[k], k, 1, half),
                     sub_ys : makelist(low_ys[k], k, 1, half),
                     sub_fit : log_log_fit_basic(sub_xs, sub_ys),
                     print("  KPM tail (lower half) slope =", sub_fit[1],
                           "  d_spec ~", 2*(sub_fit[1] + 1)),
                     sub_xs : makelist(low_xs[k], k, half + 1, n_low),
                     sub_ys : makelist(low_ys[k], k, half + 1, n_low),
                     sub_fit2 : log_log_fit_basic(sub_xs, sub_ys),
                     print("  KPM tail (upper half) slope =", sub_fit2[1],
                           "  d_spec ~", 2*(sub_fit2[1] + 1)))))
         else (
             print("KPM tail too short for slope fit."),
             d_spec_kpm : 0.0)))
else (
     print("KPM run failed; skipping."),
     d_spec_kpm : 0.0) $
if not(?boundp('d_spec_kpm)) then d_spec_kpm : 0.0 $
/* Cross-check: also estimate d_spec from the integrated DOS
    N(<= lambda) ~ lambda^(d_spec/2).  We sum the reconstructed
    DOS using a simple trapezoidal rule and report the log-log
    slope of the CDF. */
if kpm_run_ok then block(
     [grid_x : [], grid_rho : [], xx, lam, rho, cdf : 0,
      lam_list : [], cdf_list : [], xs : [], ys : [], fit, slope, prev_lam],
     for xx : -0.999 step 0.002 thru 0.99 do (
         lam : float(kpm_a + xx * kpm_b),
         rho : float(kpm_dos_at(xx, kpm_mu)),
         if rho < 0 then rho : 0,
         grid_x   : endcons(lam, grid_x),
         grid_rho : endcons(rho, grid_rho)),
     /* trapezoidal integration */
     prev_lam : grid_x[1],
     for k : 2 thru length(grid_x) do (
         cdf : cdf + 0.5 * (grid_rho[k] + grid_rho[k-1])
                       * (grid_x[k] - grid_x[k-1]),
         lam_list : endcons(grid_x[k], lam_list),
         cdf_list : endcons(cdf, cdf_list)),
     /* fit on small-lambda window */
     for k : 1 thru length(lam_list) do
         if lam_list[k] > 0.05 and lam_list[k] < 2.0
            and cdf_list[k] > 1e-6 then (
             xs : endcons(float(log(lam_list[k])), xs),
             ys : endcons(float(log(cdf_list[k])), ys)),
     if length(xs) >= 4 then (
         fit : log_log_fit_basic(xs, ys),
         slope : fit[1],
         print("KPM integrated DOS log-log slope =", slope),
         print("  => d_spec_KPM_CDF (= 2*slope) ~", 2*slope),
         d_spec_kpm_cdf : 2*slope)
     else (
         print("KPM CDF window too sparse for slope fit."),
         d_spec_kpm_cdf : 0.0)) $
if not(?boundp('d_spec_kpm_cdf)) then d_spec_kpm_cdf : 0.0 $
/* ---------------------------------------------------------------------
    SECTION 19.  Per-sheet random walk diagnostics
    ---------------------------------------------------------------------
    Run random walks restricted to NOT crossing sheets, and compare to
    the full unrestricted walk.  This isolates the effect of vortex
    edges on diffusion: if d_w_intra ~ 2 and d_w_full > 2 then vortex
    edges genuinely cause sub-diffusion via inter-sheet bottlenecks.
    --------------------------------------------------------------------- */
print("============================================================")$
print("SECTION 19: Per-sheet random walk diagnostics")$
print("============================================================")$
/* Intra-sheet random walk: at each step, restrict to neighbors on
    the same sheet as the start. */
intra_walk(start, T) := block(
     [path : [start], v : start, sh : cell_sheet[start],
      nb, allowed, r],
     for t : 1 thru T do (
         nb : nbrs[v],
         allowed : [],
         for u in nb do
             if cell_sheet[u] = sh then allowed : endcons(u, allowed),
         if length(allowed) = 0 then return(path),
         r : random(length(allowed)),
         v : allowed[r + 1],
         path : endcons(v, path)),
     path) $
/* Count how often the full walker actually crosses a sheet. */
sheet_crossing_counts : makelist(0, ii, 0, T_steps) $
intra_msd_sum : makelist(0, t, 0, min(T_steps, 100)) $
intra_walk_count : 0 $
M_intra : max(100, min(M_WALKS / 20, 2000)) $
T_intra : min(T_steps, 100) $
print("Running", M_intra, "intra-sheet walks of length", T_intra, "...")$
for w : 1 thru M_intra do block(
     [p : intra_walk(origin_id, T_intra), t, v, d],
     if length(p) > 1 then intra_walk_count : intra_walk_count + 1,
     for t : 0 thru min(T_intra, length(p) - 1) do (
         v : p[t + 1],
         d : dist_from_origin[v],
         if d < 0 then d : 0,
         intra_msd_sum[t + 1] : intra_msd_sum[t + 1] + d^2)) $
if intra_walk_count > 0 then (
     intra_msd : makelist(float(intra_msd_sum[t+1] / M_intra),
                          t, 0, T_intra),
     print("Intra-sheet MSD at t = 1, 5, 10:",
           intra_msd[2],
           if T_intra >= 5 then intra_msd[6] else 0,
           if T_intra >= 10 then intra_msd[11] else 0),
     /* Fit early-time slope. */
     block(
         [xs : [], ys : [], t, fit, slope_intra, d_w_intra],
         for t : MSD_FIT_LO thru min(T_intra, MSD_FIT_HI) do
             if intra_msd[t + 1] > 0 then (
                 xs : endcons(float(log(t)), xs),
                 ys : endcons(float(log(intra_msd[t + 1])), ys)),
         if length(xs) >= 3 then (
             fit : log_log_fit_basic(xs, ys),
             slope_intra : fit[1],
             d_w_intra : if abs(slope_intra) > 1e-6
                          then float(2/slope_intra) else 0,
             print("Intra-sheet MSD slope =", slope_intra,
                   "  =>  d_w_intra =", d_w_intra),
             print("Compare full d_w =", d_w_value,
                   "  ratio d_w_intra/d_w_full =",
                   if d_w_value > 0 then float(d_w_intra / d_w_value)
                                    else "n/a"))))$
/* Count actual sheet crossings in the original (full) walks: rerun
    a small batch. */
M_cross : min(200, M_WALKS) $
cross_sum : 0 $
for w : 1 thru M_cross do block(
     [path : random_walk(origin_id, T_steps), t, prev_sh, cur_sh, count : 0],
     for t : 2 thru length(path) do (
         prev_sh : cell_sheet[path[t - 1]],
         cur_sh  : cell_sheet[path[t]],
         if prev_sh # cur_sh then count : count + 1),
     cross_sum : cross_sum + count) $
print("Mean sheet crossings per", T_steps, "-step walk =",
       float(cross_sum / M_cross),
       " (=", float(cross_sum / (M_cross * T_steps)), "per step)")$
/* ---------------------------------------------------------------------
    SECTION 20.  Cross-tau dimensional comparison
    ---------------------------------------------------------------------
    Estimate d_eff and a cheap d_w surrogate on the depth-3 cluster
    built under EACH alternative tau-rule.  This shows how the choice
    of vortex structure modulates geometry-level quantities.
    --------------------------------------------------------------------- */
print("============================================================")$
print("SECTION 20: Cross-tau dimensional comparison")$
print("============================================================")$
/* BFS volumes from given root in a snapshot's nbr_list. */
snapshot_bfs_volumes(root, nbr_list, n_cells) := block(
     [visited : makelist(false, ii, 1, n_cells),
      dist : makelist(-1, ii, 1, n_cells),
      queue : [root], v, j, max_d : 0, sizes],
     visited[root] : true, dist[root] : 0,
     while length(queue) > 0 do (
         v : first(queue), queue : rest(queue),
         for j in nbr_list[v] do
             if not visited[j] then (
                 visited[j] : true,
                 dist[j] : dist[v] + 1,
                 if dist[j] > max_d then max_d : dist[j],
                 queue : endcons(j, queue))),
     sizes : makelist(0, ii, 0, max_d),
     for ii : 1 thru n_cells do
         if dist[ii] >= 0 then
             sizes[dist[ii] + 1] : sizes[dist[ii] + 1] + 1,
     for r : 2 thru length(sizes) do
         sizes[r] : sizes[r] + sizes[r-1],
     sizes) $
tau_dim_results : [] $
for tp in tau_panel do block(
     [label : tp[1], tau_fn : tp[2], snap, vols, n_c, nbrlist, root,
      xs, ys, fit, d_eff_tau, r],
     snap : build_cluster_tau(tau_fn, TAU_SURVEY_DEPTH),
     n_c : snap[1], nbrlist : snap[5], root : snap[6],
     vols : snapshot_bfs_volumes(root, nbrlist, n_c),
     d_eff_tau : 0.0,
     if length(vols) >= 4 then block(
         [xs : [], ys : []],
         for r : 2 thru length(vols) - 1 do (
             xs : endcons(float(log(r - 1)), xs),
             ys : endcons(float(log(vols[r])), ys)),
         fit : log_log_fit_basic(xs, ys),
         d_eff_tau : fit[1]),
     print("  tau =", label,
           "  N=", n_c,
           "  BFS-radius=", length(vols) - 1,
           "  vols(last)=", last(vols),
           "  d_eff~", d_eff_tau),
     tau_dim_results : endcons([label, n_c, d_eff_tau], tau_dim_results)) $
/* Identify the tau-rule with the most strongly fractional d_eff
    (i.e. closest to the predicted 2.5 midpoint of the (2,3) window). */
best_dim_label : "" $
best_dim_dist  : 1000 $
for r in tau_dim_results do block(
     [d : abs(r[3] - 2.5)],
     if r[3] > 0 and d < best_dim_dist then (
         best_dim_dist : d,
         best_dim_label : r[1])) $
print("Most-fractional (closest to d_eff=2.5) tau-rule:",
       best_dim_label,
       "  |d_eff - 2.5| =", best_dim_dist)$
/* ---------------------------------------------------------------------
    SECTION 21.  Resistance distance and commute time (sample)
    ---------------------------------------------------------------------
    For a sample of pairs of nodes, estimate the effective resistance
    R(u,v) via short random-walk-based commute time:
        E[commute(u,v)] = 2 * |E| * R(u,v)
    A scaling R(u,v) ~ dist(u,v)^(d_w - d_eff + 1) characterizes
    transport on fractal graphs.  We test this on a few intra-sheet
    pairs and a few cross-sheet pairs.
    --------------------------------------------------------------------- */
print("============================================================")$
print("SECTION 21: Commute-time sampling")$
print("============================================================")$
/* First-hitting time of target starting from source. */
hit_time(source, target, T_max) := block(
     [v : source, t : 0, nb, r],
     while v # target and t < T_max do (
         nb : nbrs[v],
         if length(nb) = 0 then return(-1),
         r : random(length(nb)),
         v : nb[r + 1],
         t : t + 1),
     if v = target then t else -1) $
/* Estimate commute time via M_hit hitting-time samples (both directions). */
commute_estimate(u, v, M_hit, T_max) := block(
     [sum_uv : 0, sum_vu : 0, n_uv : 0, n_vu : 0, k, h],
     for k : 1 thru M_hit do (
         h : hit_time(u, v, T_max),
         if h >= 0 then (sum_uv : sum_uv + h, n_uv : n_uv + 1)),
     for k : 1 thru M_hit do (
         h : hit_time(v, u, T_max),
         if h >= 0 then (sum_vu : sum_vu + h, n_vu : n_vu + 1)),
     if n_uv > 0 and n_vu > 0 then
         float(sum_uv / n_uv + sum_vu / n_vu)
     else -1.0) $
/* Pick a few sample target nodes at varying BFS distances. */
sample_targets : [] $
for d_target : 1 thru min(BFS_DEPTH, 4) do block(
     [found : 0, i],
     for i : 1 thru N do
         if found < 2 and dist_from_origin[i] = d_target then (
             sample_targets : endcons([i, d_target], sample_targets),
             found : found + 1)) $
print("Commute-time samples from origin (subset):")$
commute_data : [] $
M_hit_sample : max(20, min(200, M_WALKS / 100)) $
T_max_sample : max(100, T_STEPS) $
for tp in sample_targets do block(
     [v : tp[1], d : tp[2], ct, sh_v : cell_sheet[tp[1]]],
     ct : commute_estimate(origin_id, v, M_hit_sample, T_max_sample),
     if ct > 0 then (
         commute_data : endcons([d, sh_v, ct], commute_data),
         print("  target=", v, " dist=", d, " sheet=", sh_v,
               " commute_est=", ct))) $
/* Log-log fit of commute time vs distance. */
if length(commute_data) >= 3 then block(
     [xs : [], ys : [], pt, fit, slope, d_w_eff],
     for pt in commute_data do
         if first(pt) > 0 and third(pt) > 0 then (
             xs : endcons(float(log(first(pt))), xs),
             ys : endcons(float(log(third(pt))), ys)),
     if length(xs) >= 3 then (
         fit : log_log_fit_basic(xs, ys),
         slope : fit[1],
         /* For a fractal graph: commute(u,v) ~ |E| * R(u,v)
            ~ dist(u,v)^(d_w - d_eff + 2).  Inverting:
            d_w ~ d_eff + slope - 2.  But that's marginal here. */
         print("Commute-time log-log slope =", slope),
         print("  Interpretation: ~ dist^slope; for d_w > 2 expect slope > 1"))) $
/* ---------------------------------------------------------------------
    SECTION 22.  Summary report (was Section 10)
    --------------------------------------------------------------------- */
/* ---------------------------------------------------------------------
   SECTION 10.  Summary report
   --------------------------------------------------------------------- */

print("============================================================")$
print("experiment.mac : summary  (N_GON =", N_GON, ")")$
print("============================================================")$
print("Preset =", EXPERIMENT_PRESET,
       " (BFS_DEPTH =", BFS_DEPTH,
       ", M_WALKS =", M_WALKS,
       ", T_STEPS =", T_STEPS,
       ", T_CA =", T_CA, ")")$
print("N_GON =", N_GON,
        "  interior angle =", float(theta_int_n * 180 / %pi), "deg",
        "  k_flat =", k_flat_n,
        "  fiber order =", FIBER_ORDER_N)$
print("Cluster size N =", N)$
print("Mean degree =", deg_mean,
       " (", n_int, "-regular target; lower at boundary)")$
print("Sheets occupied =", sheet_set)$
if eig_skipped then
     print("Spectral gap = (skipped)")
else
     print("Spectral gap =", spec_gap)$
print("d_eff estimate (BFS) =", d_eff_est)$
print("d_eff estimate (BFS, full) =", d_eff_full)$
if not eig_skipped then
     print("d_spec estimate (DOS) =", d_spec_dos)$
print("d_w   estimate (MSD) =", d_w_value)$
print("d_spec estimate (P_0) =", d_spec_value)$
if d_w_value > 0 then
    print("d_spec (Alexander-Orbach) =",
          float(2 * d_eff_est / d_w_value))$
if d_spec_kpm > 0 then
     print("d_spec (KPM low-lambda)   =", d_spec_kpm)$
if d_spec_kpm_cdf > 0 then
     print("d_spec (KPM integrated)   =", d_spec_kpm_cdf)$
print("Vortex edges =", n_vortex_edges_in_cluster,
      " / total edges =", apply("+", deg_list) / 2)$
print("CA final population =", final_pop, "after", T_ca, "steps")$
print("Rule panel: extinct=", n_extinct,
       " still=", n_still,
       " periodic=", n_period,
       " growing=", n_growing,
       " active=", n_active)$
if length(best_rule) > 0 then
     print("Most active panel rule:", best_rule[1],
           "  max_pop =", best_rule[7])$
print("Richest-holonomy tau-rule =", best_tau_label,
       "  score =", best_tau_score)$
print("Triangles in main cluster =", triangle_count)$
print("Girth through origin =",
       if girth_origin > 0 then girth_origin else "> 8")$
print("Glider hunt: oscillators =", n_oscillators,
       "  gliders =", n_gliders, " (trials =", length(glider_summary), ")")$
print("Long cycles enumerated through origin:",
       length(all_cycles_origin), " (up to length", LONG_LOOP_MAX, ")")$
print("Cap-window cluster: N =", cap_N,
       ", sheets =", cap_sheet_set)$
if d_spec_kpm > 0 then
     print("KPM-based d_spec ~", d_spec_kpm)$
print("Most-fractional tau-rule:", best_dim_label,
       "  |d_eff - 2.5| =", best_dim_dist)$
print("------------------------------------------------------------")$
print("Active TAU_MODE for main cluster:", TAU_MODE)$
print("Preset:", EXPERIMENT_PRESET)$
print("N_GON:", N_GON)$
print("------------------------------------------------------------")$
print("Caveats:")$
print("  * N_GON controls the polygon type.  Set it at the top of")$
print("    Section 0 to study triangles (3), squares (4), pentagons")$
print("    (5), hexagons (6), heptagons (7), etc.")$
print("  * For n in {3,4,6} the tiling closes flat (deficit=0); the")$
print("    sheet structure is driven entirely by the tau rule.")$
print("  * Deeper BFS (depth 6, xhuge preset) gives ~thousands of")$
print("    cells; dimension fits are improved but still finite-size.")$
print("  * TAU_MODE controls whether the main cluster uses the")$
print("    didactic every-n rule, the signed-n rule (richer monodromy),")$
print("    or the rigorous cut-and-project window of idea.md §2.4.")$
print("  * KPM spectral analysis (Section 18) is the preferred")$
print("    method for large clusters where dense eigendecomposition")$
print("    is infeasible.  Both low-lambda slope and integrated-DOS")$
print("    slope are reported for cross-validation.")$
print("  * Same-orientation tiling is geometrically frustrated; this")$
print("    experiment lets the sheet index absorb the angular deficit,")$
print("    consistent with the multi-sheeted construction.")$
print("============================================================")$
print("experiment.mac : done.")$
print("============================================================")$